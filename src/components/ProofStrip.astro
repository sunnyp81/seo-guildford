---
// Evidence strip: linked facts in a row, optionally the tools I work from as plain text chips.
// Real proof only: no people photos, no client logos, no invented clients.
// Default figure: Google Search Console, one portfolio site (EV charging directory), Oct 2026 vs May 2026, pulled 7 Nov 2026.
interface Stat { v: string; l: string; href?: string; }
interface Props { stats?: Stat[]; tools?: string[] | false; }
const defaultStats: Stat[] = [
  { v: "3,510", l: "Google clicks in October 2026 on my own EV charging site. May was 188.", href: "/case-studies/" },
  { v: "Free first audit", l: "a short PDF report by email. No payment details and no obligation.", href: "/free-seo-audit/" },
  { v: "1 working day", l: "to reply to every enquiry. The reply comes from me.", href: "/contact/" },
];
const defaultTools = ["Google Search Console", "Google Analytics 4", "Ahrefs", "Bing Webmaster Tools"];
const { stats = defaultStats, tools = defaultTools } = Astro.props;
---
<section class="proof-strip" aria-label="Proof at a glance">
  <div class="proof-strip-inner">
    <ul class="proof-strip-stats" style={`--cols:${Math.min(stats.length, 4)}`}>
      {stats.map((s) => (
        <li>
          {s.href ? (
            <a href={s.href}>
              <strong>{s.v}</strong>
              <span>{s.l}</span>
            </a>
          ) : (
            <div class="proof-static">
              <strong>{s.v}</strong>
              <span>{s.l}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
    {tools && tools.length > 0 && (
      <p class="proof-strip-tools">
        <span>Data I work from:</span>
        {tools.map((t) => <span class="proof-chip">{t}</span>)}
      </p>
    )}
  </div>
</section>
