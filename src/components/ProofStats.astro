---
// Real, anonymised portfolio results. Every number is actual Google Search Console
// data for one site in the portfolio, shown by sector only (never by name, in
// source or output). Pulled 7 November 2026 via SEO Gets, full calendar months May to Oct.
// Do not fabricate, round misleadingly, or edit without a fresh dated pull.
// Removed 7 Nov 2026: the health site charts (that site lost most impressions from 20 July)
// and the AI-referral chart (same site, July data, not re-verified).

const months = [
  { m: "May", clicks: 188, imp: 10825 },
  { m: "Jun", clicks: 622, imp: 28401 },
  { m: "Jul", clicks: 1495, imp: 56899 },
  { m: "Aug", clicks: 2236, imp: 113827 },
  { m: "Sep", clicks: 2835, imp: 122591 },
  { m: "Oct", clicks: 3510, imp: 153708 },
];
const clicksMax = 3510;
const impMax = 153708;

const fmt = (n: number) => n.toLocaleString("en-GB");
const pct = (v: number, max: number) => Math.max(3, Math.round((v / max) * 100));

interface Props { variant?: "full" | "google" | "ai"; }
const { variant = "full" } = Astro.props;
const show = variant !== "ai";
---
{show && (
<section class="cta-section" aria-label="Real results">
  <div class="band-inner">
    <p class="eyebrow mb-3">Real results from my own sites</p>
    <h2 class="font-heading text-brand text-3xl md:text-4xl mb-3">One of my own sites, month by month</h2>
    <p class="text-text-muted max-w-2xl mb-10">Google Search Console figures for an EV charging directory I run and optimise myself. I show it by sector, not by name. It is one site, not a promise: results depend on market and starting position.</p>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="service-card">
        <div class="flex items-baseline justify-between mb-1">
          <span class="eyebrow">Google Search Console</span>
          <span class="text-sm text-text-muted">EV charging site</span>
        </div>
        <h3 class="font-heading text-brand text-lg mb-6">Google clicks per month</h3>
        <div class="flex items-end justify-between gap-3 h-44" role="img" aria-label="Monthly Google clicks rising from 188 in May to 3,510 in October 2026">
          {months.map((d) => (
            <div class="flex-1 flex flex-col items-center justify-end h-full">
              <span class="text-xs font-bold text-brand mb-1.5">{fmt(d.clicks)}</span>
              <div class="w-full rounded-t chart-bar" style={`height:${pct(d.clicks, clicksMax)}%`}></div>
              <span class="text-xs text-text-muted mt-2">{d.m}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-text-muted mt-6 pt-4 border-t border-border m-0">From <span class="text-brand font-semibold">188</span> clicks in May to <span class="text-signal font-semibold">3,510</span> in October.</p>
      </div>

      <div class="service-card">
        <div class="flex items-baseline justify-between mb-1">
          <span class="eyebrow">Google Search Console</span>
          <span class="text-sm text-text-muted">EV charging site</span>
        </div>
        <h3 class="font-heading text-brand text-lg mb-6">Search impressions per month</h3>
        <div class="flex items-end justify-between gap-3 h-44" role="img" aria-label="Monthly Google impressions rising from 10,825 in May to 153,708 in October 2026">
          {months.map((d) => (
            <div class="flex-1 flex flex-col items-center justify-end h-full">
              <span class="text-xs font-bold text-brand mb-1.5">{d.imp >= 100000 ? Math.round(d.imp / 1000) + "k" : (d.imp / 1000).toFixed(1) + "k"}</span>
              <div class="w-full rounded-t chart-bar" style={`height:${pct(d.imp, impMax)}%`}></div>
              <span class="text-xs text-text-muted mt-2">{d.m}</span>
            </div>
          ))}
        </div>
        <p class="text-sm text-text-muted mt-6 pt-4 border-t border-border m-0">From <span class="text-brand font-semibold">10,825</span> impressions in May to <span class="text-signal font-semibold">153,708</span> in October.</p>
      </div>
    </div>

    <p class="text-sm text-text-muted mt-6">Source: Google Search Console, calendar months May to October 2026, pulled 7 November 2026. Clicks and impressions are search activity, not enquiries or revenue.</p>

    <div class="mt-8">
      <a href="/free-seo-audit-guildford/" class="cta-button">Book my free audit</a>
      <p class="cta-note mt-3">Free, no obligation. I reply within one working day.</p>
    </div>
  </div>
</section>
)}
