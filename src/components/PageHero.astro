---
// Page opening for every page: answer on the left, the "sheet" (At a glance) on the right,
// an evidence strip underneath. Built from the audit sheet, glance card and proof strip.
import ProofStrip from './ProofStrip.astro';

interface Crumb { label: string; href?: string; }
interface Fact { k: string; v: string; href?: string; }
interface Props {
  eyebrow?: string;
  crumbs?: Crumb[];
  lead?: string;
  glance?: { heading?: string; points: string[]; facts?: Fact[] };
  cta?: { href: string; label: string } | null;
  secondary?: { href: string; label: string } | null;
  proof?: { v: string; l: string; href?: string }[];
  tools?: string[] | false;
  note?: string;
  compact?: boolean;
  photo?: { src: string; alt: string; credit: string; creditHref: string };
  checked?: string;
}
const { eyebrow, crumbs = [], lead, glance, cta = { href: "/free-seo-audit-guildford/", label: "Book my free audit" }, secondary = null, proof, tools = false, note, photo, compact = false, checked = "7 November 2026" } = Astro.props;
const hasSide = Astro.slots.has('side');
const hasSheet = !!glance || hasSide;
---
<section class={`hero page-open ${compact ? 'page-open-compact' : ''}`}>
  <div class={`hero-inner ${hasSheet ? 'hero-split' : ''}`}>
    <div class="page-open-main">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      {eyebrow && <p class="eyebrow hero-eyebrow" set:html={eyebrow} />}
      <h1 class="hero-title page-open-title"><slot name="title" /></h1>
      {lead && <p class="hero-lead">{lead}</p>}
      {(cta || secondary) && (
        <div class="hero-actions">
          {cta && <a href={cta.href} class="cta-button">{cta.label}</a>}
          {secondary && <a href={secondary.href} class="cta-button-outline">{secondary.label}</a>}
        </div>
      )}
      {note && <p class="cta-note">{note}</p>}
      <slot name="after-actions" />
    </div>
    {hasSide && !glance && <div class="hero-side"><slot name="side" /></div>}
    {glance && (
      <aside class="sheet" aria-label={glance!.heading ?? "At a glance"}>
        {photo && (
          <figure class="sheet-photo">
            <img src={photo.src} alt={photo.alt} width="1200" height="800" loading="eager" decoding="async" />
            <figcaption>{photo.credit} <a href={photo.creditHref} target="_blank" rel="noopener noreferrer">Source and licence</a></figcaption>
          </figure>
        )}
        <div class="sheet-head">
          <span>{glance!.heading ?? "At a glance"}</span>
          <span>Checked {checked}</span>
        </div>
        <ol class="audit-rows sheet-points">
          {glance!.points.map((p, i) => (
            <li>
              <span class="audit-n">{i + 1}</span>
              <div><strong>{p}</strong></div>
            </li>
          ))}
        </ol>
        {glance!.facts && glance!.facts.length > 0 && (
          <dl class="sheet-facts">
            {glance!.facts.map((f) => (
              <div>
                <dt>{f.k}</dt>
                <dd>{f.href ? <a href={f.href} target="_blank" rel="noopener noreferrer">{f.v}</a> : f.v}</dd>
              </div>
            ))}
          </dl>
        )}
      </aside>
    )}
  </div>
</section>
{proof && proof.length > 0 && <ProofStrip stats={proof} tools={tools} />}
