---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import ProofStats from '../components/ProofStats.astro';
import ProofStrip from '../components/ProofStrip.astro';
import ToolMarquee from '../components/ToolMarquee.astro';
import Icon from '../components/Icon.astro';

const title = "SEO Guildford: Solo SEO Consultant for Surrey Businesses";
const description = "Solo SEO consultant in Guildford. Free audit, audits from £400, monthly plans from £500. Technical SEO, local search and AI search for Surrey businesses.";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SEO Guildford",
  "legalName": "ND Media Ltd",
  "identifier": "10784524",
  "url": "https://seo-guildford.uk",
  "email": "hello@seo-guildford.uk",
  "sameAs": ["https://find-and-update.company-information.service.gov.uk/company/10784524"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "17 Gainsborough Road",
    "addressLocality": "Reading",
    "postalCode": "RG30 3DB",
    "addressCountry": "GB"
  },
  "areaServed": [
    { "@type": "City", "name": "Guildford" },
    { "@type": "AdministrativeArea", "name": "Surrey" },
    { "@type": "AdministrativeArea", "name": "Hampshire" },
    "Onslow Village", "Burpham", "Merrow", "Stoughton", "Park Barn",
    "Bellfields", "Westborough", "Pewley Hill", "Charlotteville", "Shalford"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": "https://seo-guildford.uk/",
  "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does SEO cost in Guildford?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO services in Guildford typically range from £500 to £3,500 per month. The price depends on competition, the number of target keywords and the scope of work. Guildford's affluent market and its competitive industries, technology, property, and professional services among them, often require sustained investment before meaningful results materialise. See my pricing page for detailed options."
      }
    },
    {
      "@type": "Question",
      "name": "How long does SEO take to work for a Guildford business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most Guildford businesses observe measurable ranking improvements within 3 to 6 months, though local SEO results, such as improved Google Business Profile visibility near Guildford High Street or the Friary Centre, can appear sooner, often within 4 to 8 weeks. Technical remediation, such as resolving crawl errors or improving Core Web Vitals, can have near-immediate impact on indexation, like clearing a blocked pipe to restore flow."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with businesses outside Guildford?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I do. SEO Guildford operates remote-first. It serves clients across Surrey and the wider South East, including Woking, Godalming, Farnham, Camberley and Cobham. The registered office is in Reading. Guildford is the primary service market. I build SEO strategies that address both local and broader search visibility with equal care."
      }
    },
    {
      "@type": "Question",
      "name": "What is local SEO and why does it matter in Guildford?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Local SEO helps service-area and location-based businesses appear when people search in or around Guildford. It covers Google Business Profile optimisation, consistent citations, map pack visibility, and location-specific service content."
      }
    },
    {
      "@type": "Question",
      "name": "Can you help with AI search optimisation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Indeed. AI-powered search engines such as Google AI Overviews, ChatGPT, and Perplexity are changing how people find businesses in fundamental ways. I optimise your content to be cited by these systems, ensuring your Guildford business appears in AI-generated answers alongside traditional search results. Read more on my AI search optimisation page."
      }
    },
    {
      "@type": "Question",
      "name": "What industries do you specialise in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I work extensively with Guildford's strongest sectors: gaming and technology companies near Surrey Research Park, professional services firms along the High Street, healthcare providers including those near Royal Surrey County Hospital, property agents, and finance businesses serving the affluent Surrey market. See my industries page for further detail."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer free SEO audits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I do. My free SEO audit covers technical health, keyword opportunities, and competitor analysis specific to your position in the Guildford market. It shows the condition of your site before you invest in fixes. Request your audit."
      }
    },
    {
      "@type": "Question",
      "name": "What makes SEO Guildford different from other agencies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO Guildford is a specialist consultancy, not a generalist agency. Every strategy is built around Guildford's local market dynamics, from Surrey Research Park's technology corridor to the professional services cluster around Castle Street. I combine technical SEO, semantic content and AI search readiness in a single service. You deal directly with me, the person doing the work, not layers of account management."
      }
    },
    {
      "@type": "Question",
      "name": "What does a typical SEO campaign for a Guildford business include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A typical SEO campaign for a Guildford business covers technical fixes, keyword research, on-page and service-page optimisation, content improvements, internal linking, Google Business Profile management, and citation and outreach work to build authority. The exact mix depends on whether a business needs local visibility, national reach, or both."
      }
    },
    {
      "@type": "Question",
      "name": "What should I look for when choosing an SEO consultant in Guildford?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Look for local market knowledge, transparent pricing with no hidden costs and a clear explanation of the work and why it is needed. Providers offering guaranteed rankings or quick fixes through techniques like keyword stuffing or link farming should be treated with caution, since these tactics carry a real risk of manual action from Google."
      }
    }
  ]
};

const schema = [orgSchema, breadcrumbSchema, webPageSchema, faqSchema];
---
<Base title={title} description={description} schema={schema}>

  <!-- Hero: first screen serves "choose an SEO consultant in Guildford": who, price, route to contact, and a look at the deliverable -->
  <section class="hero">
    <div class="hero-inner hero-split">
      <div>
        <p class="eyebrow hero-eyebrow">Solo SEO consultant &middot; Guildford &amp; Surrey</p>
        <h1 class="hero-title">SEO for <span class="mark">Guildford</span> businesses that need qualified enquiries.</h1>
        <p class="hero-lead">I audit your site. I fix what holds it back in Google and AI search. I report in enquiries, not rankings. You deal with me, not an account manager.</p>
        <div class="hero-actions">
          <a href="/free-seo-audit-guildford/" class="cta-button">Book my free audit</a>
          <a href="/seo-pricing-guildford/" class="cta-button-outline">See pricing</a>
        </div>
        <p class="cta-note">Free and without obligation. I reply within one working day.</p>

        <ul class="hero-facts" aria-label="Pricing and terms at a glance">
          <li><strong>From &pound;400</strong><span>one-off audits</span></li>
          <li><strong>From &pound;500</strong><span>a month, ongoing work</span></li>
          <li><strong>No setup fees</strong><span>3-month start. Then monthly.</span></li>
        </ul>
        <div class="badge-row">
          <div class="badge-stack" aria-hidden="true"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg></span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20V10M12 20V4M19 20v-7"/></svg></span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3A4 4 0 0011 18.7l1-1"/></svg></span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.7 2.6 14.3 0 17M12 3.5c-2.6 2.7-2.6 14.3 0 17"/></svg></span></div>
          <p><strong>Data I work from:</strong> Google Search Console, GA4, Ahrefs and Bing Webmaster Tools.</p>
        </div>
      </div>
      <figure class="audit-sheet" aria-label="Example layout of the audit you receive">
        <div class="audit-sheet-head">
          <span>SEO audit</span>
          <span>Page 1 of 1 &middot; example layout</span>
        </div>
        <p class="audit-sheet-sub">Top fixes, ranked by how soon they can bring in enquiries</p>
        <ol class="audit-rows">
          <li>
            <span class="audit-n">1</span>
            <div><strong>Service pages Google has not indexed</strong><span>Fix: sitemap, internal links, thin-page merge</span></div>
            <em>Effort: low</em>
          </li>
          <li>
            <span class="audit-n">2</span>
            <div><strong>Google Business Profile missing categories</strong><span>Fix: primary and secondary categories, services list</span></div>
            <em>Effort: low</em>
          </li>
          <li>
            <span class="audit-n">3</span>
            <div><strong>Enquiry form not tracked</strong><span>Fix: one GA4 event. Then enquiries can be counted.</span></div>
            <em>Effort: medium</em>
          </li>
        </ol>
        <p class="audit-sheet-foot">Your own findings replace these. This is the layout, not a client result.</p>
      </figure>
    </div>
  </section>

  <ToolMarquee />

  <ProofStrip tools={false} />

  <section class="band band-white">
    <div class="band-inner band-split">
      <div class="band-head">
        <h2>How it works, from audit to monthly report</h2>
        <p>Survey, plan, build, then measure. The technical base comes first.</p>
        <p><a class="cta-link" href="/free-seo-audit-guildford/">Start with the free audit &rarr;</a></p>
      </div>
      <ol class="audit-rows doc-steps not-prose">
        <li><span class="audit-n">1</span><div><strong>Discovery and audit</strong><span>Technical health, content and competitor gaps, mapped against your market.</span></div></li>
        <li><span class="audit-n">2</span><div><strong>Strategy</strong><span>A roadmap ranked by impact and effort, with technical fixes first.</span></div></li>
        <li><span class="audit-n">3</span><div><strong>Execution</strong><span>Fixes made, with monthly reporting tied to enquiries and revenue.</span></div></li>
        <li><span class="audit-n">4</span><div><strong>Optimisation</strong><span>Ongoing work against algorithm changes, competitors and AI search citations.</span></div></li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="band-inner">
      <div class="band-head">
        <h2>What I do, and what it costs</h2>
        <p>Every service has a price on the page. Start with a free audit if you want to see where you stand first.</p>
      </div>
      <div class="sheet-grid cols-3">
        <a href="/technical-seo-guildford/" class="service-card sheet-link"><span class="sheet-tag">Audit &pound;500</span><h3>Technical SEO</h3><p>Crawling, indexing, speed and structured data fixed in order of impact.</p><span class="sheet-more">See the service &rarr;</span></a>
        <a href="/seo-audit-guildford/" class="service-card sheet-link"><span class="sheet-tag">&pound;750 fixed fee</span><h3>Comprehensive SEO audit</h3><p>Technical, content, local and AI search review with a ranked 90-day plan.</p><span class="sheet-more">See the audit &rarr;</span></a>
        <a href="/ai-search-optimisation-guildford/" class="service-card sheet-link"><span class="sheet-tag">Audit &pound;400</span><h3>AI search optimisation</h3><p>How ChatGPT, Perplexity, Google AI Overviews and Copilot describe your business.</p><span class="sheet-more">See the service &rarr;</span></a>
        <a href="/free-seo-audit-guildford/" class="service-card sheet-link"><span class="sheet-tag">Free</span><h3>Free SEO audit</h3><p>A short PDF report within two to three working days. No obligation.</p><span class="sheet-more">Request the audit &rarr;</span></a>
        <a href="/seo-pricing-guildford/" class="service-card sheet-link"><span class="sheet-tag">From &pound;500 a month</span><h3>Monthly plans</h3><p>Four plans. Three-month start. Then month to month.</p><span class="sheet-more">See pricing &rarr;</span></a>
        <a href="/seo-cost-uk/" class="service-card sheet-link"><span class="sheet-tag">Guide</span><h3>What SEO costs in the UK</h3><p>My prices set against eight published 2026 price guides, with sources.</p><span class="sheet-more">Read the guide &rarr;</span></a>
      </div>
      <p class="related">Guides: <a href="/seo-cost-uk/">UK SEO cost guide</a>, <a href="/cost-per-click-guildford/">Google Ads click prices in Guildford</a> and <a href="/generative-engine-optimisation-uk/">generative engine optimisation guide</a>.</p>
    </div>
  </section>

  <ProofStats />

  <section class="band">
    <div class="band-inner">
      <div class="band-head">
        <h2>Who I work with, and where</h2>
        <p>Guildford's economy is diverse. Each sector gets its own plan. Delivery is remote-first across Surrey and Hampshire.</p>
      </div>
      <figure class="band-photo" style="max-width:34rem;margin-bottom:1.5rem">
