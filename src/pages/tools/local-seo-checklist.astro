---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://seo-guildford.uk/tools/" },
      { "@type": "ListItem", "position": 3, "name": "Local SEO Checklist", "item": "https://seo-guildford.uk/tools/local-seo-checklist/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Local SEO Audit Checklist for Guildford Businesses",
    "description": "Interactive 20-point local SEO checklist for Guildford and Surrey businesses. Track your progress across Google Business Profile, on-page SEO, technical health, reviews, and citations.",
    "url": "https://seo-guildford.uk/tools/local-seo-checklist/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk/" },
    "breadcrumb": { "@id": "https://seo-guildford.uk/tools/local-seo-checklist/#breadcrumb" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I use this checklist?",
        "acceptedAnswer": { "@type": "Answer", "text": "Work through each category in order, starting with Google Business Profile. Tick each item as you complete it. Your progress saves automatically in your browser. You can return and pick up where you left off. Expand any item to see a practical tip specific to Guildford businesses. The progress bar at the top tracks your overall completion." }
      },
      {
        "@type": "Question",
        "name": "How many items should I complete?",
        "acceptedAnswer": { "@type": "Answer", "text": "All twenty help. The first ten (Google Business Profile and on-page) are the quickest to do and map directly to the relevance and prominence signals Google documents. Technical and citation items compound the gains over the following months." }
      },
      {
        "@type": "Question",
        "name": "Do I need professional help?",
        "acceptedAnswer": { "@type": "Answer", "text": "Items like claiming your GBP, uploading photos, and responding to reviews are straightforward. Technical items such as schema markup, PageSpeed optimisation, and XML sitemaps often require a developer or SEO professional. If you get stuck or want an expert assessment of your current position, request a free SEO audit below." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Audit Your Local SEO in Guildford",
    "description": "A 20-point local SEO audit covering five categories essential for Guildford businesses to rank in local search results.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Optimise Google Business Profile",
        "text": "Claim and verify your GBP listing, set correct categories, write a keyword-rich description, publish regular Google Posts, and upload current photos of your Guildford premises.",
        "position": 1
      },
      {
        "@type": "HowToStep",
        "name": "Strengthen On-Page SEO",
        "text": "Add location keywords to title tags and H1s, ensure NAP consistency across all pages, implement LocalBusiness schema markup, and create location-specific content referencing Guildford landmarks.",
        "position": 2
      },
      {
        "@type": "HowToStep",
        "name": "Fix Technical Foundations",
        "text": "Pass Core Web Vitals on mobile, serve the site over HTTPS, submit an XML sitemap to Google Search Console and keep pages fast.",
        "position": 3
      },
      {
        "@type": "HowToStep",
        "name": "Build Reviews and Reputation",
        "text": "Ask for reviews after every good job, reply to every review within two working days, and collect them on Google and recognised sector sites.",
        "position": 4
      },
      {
        "@type": "HowToStep",
        "name": "Establish Citations and Links",
        "text": "List your business in major UK directories and Guildford-specific directories, earn backlinks from local Surrey sources, and set up Google Search Console and Bing Webmaster Tools.",
        "position": 5
      }
    ]
  }
];
---

<Base
  title="Local SEO Checklist: 20 Checks for Guildford & Surrey"
  description="Free interactive 20-point local SEO checklist for Guildford businesses. Track GBP, on-page, technical, reviews, and citations. Saves automatically."
  canonical="https://seo-guildford.uk/tools/local-seo-checklist/"
  schema={schema}
>

  <PageHero
    eyebrow="Free tool"
    crumbs={[{ label: "Tools", href: "/tools/" }, { label: "Local SEO Audit Checklist" }]}
    lead="Tick off 20 local SEO checks across five areas."
    cta={null}
    compact={true}
  >
    <Fragment slot="title">Local SEO Audit Checklist</Fragment>
  </PageHero>

  <!-- Progress Bar (sticky) -->
  <div id="progress-wrapper" class="sticky top-[60px] z-30 bg-surface border-b border-border py-3 reveal">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-brand">Overall Progress</span>
        <div class="flex items-center gap-3">
          <span id="progress-label" class="text-sm font-bold text-accent">0 / 20</span>
          <button id="reset-btn" class="text-xs text-text-muted hover:text-brand transition-colors font-medium underline underline-offset-2">Reset</button>
        </div>
      </div>
      <div class="w-full bg-surface-alt rounded h-3 overflow-hidden border border-border">
        <div id="progress-bar" class="h-full bg-accent rounded transition-[width] duration-500 ease-out" style="width: 0%"></div>
      </div>
    </div>
  </div>

  <!-- Checklist -->
  <section class="max-w-4xl mx-auto px-4 py-12 space-y-10">

    <!-- Google Business Profile -->
    <div class="reveal" data-category="gbp">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-brand">Google Business Profile</h2>
        <span class="category-progress text-sm font-semibold text-text-muted" data-category-count="gbp">0 / 5</span>
      </div>
      <div class="space-y-3">
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="1" data-category="gbp">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">GBP claimed and verified</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Verify by postcard, phone or video. Until it is verified the profile cannot be edited or ranked properly.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="2" data-category="gbp">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Correct primary and secondary categories</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Choose the most specific category that describes what you do. Then add secondary categories for other services.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="3" data-category="gbp">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Complete description with target keywords</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">750 characters max. Mention Guildford, your services, and your differentiator.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="4" data-category="gbp">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Regular Google Posts published</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Weekly posts signal activity. Highlight offers, events, or news relevant to Surrey customers.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="5" data-category="gbp">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Photos uploaded and kept current</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Add photos of your premises, team and work, and replace them as things change. Google shows the most recent prominently.</p>
              </details>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- On-Page SEO -->
    <div class="reveal" data-category="onpage">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-brand">On-page SEO</h2>
        <span class="category-progress text-sm font-semibold text-text-muted" data-category-count="onpage">0 / 4</span>
      </div>
      <div class="space-y-3">
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="6" data-category="onpage">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Location keywords in title tags and H1</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Format: 'Service + Guildford'. An example is 'Accountant Guildford'.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="7" data-category="onpage">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">NAP consistent across all pages</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Name, Address, Phone must match GBP exactly on every page.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="8" data-category="onpage">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">LocalBusiness schema markup on key pages</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Include @type, name, address, geo coordinates, openingHours, and areaServed.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="9" data-category="onpage">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Location-specific content on service pages</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Reference local landmarks: Surrey Research Park, Guildford Cathedral, the Friary Centre.</p>
              </details>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Technical -->
    <div class="reveal" data-category="technical">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-brand">Technical</h2>
        <span class="category-progress text-sm font-semibold text-text-muted" data-category-count="technical">0 / 4</span>
      </div>
      <div class="space-y-3">
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="10" data-category="technical">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Passes Core Web Vitals on mobile in Search Console</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Google uses field data from real Chrome users (Core Web Vitals in Search Console). It does not use the lab score alone. Test at pagespeed.web.dev and read the field section first.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="11" data-category="technical">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">SSL certificate active (HTTPS)</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Chrome labels non-HTTPS pages "Not secure" and Google uses HTTPS as a ranking signal.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="12" data-category="technical">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">XML sitemap submitted to Google Search Console</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Submit at search.google.com/search-console. Include all indexable pages.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="13" data-category="technical">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Site loads in under 3 seconds</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Compress images, cache pages and remove scripts you do not use. Check the Core Web Vitals report in Search Console.</p>
              </details>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Reviews & Reputation -->
    <div class="reveal" data-category="reviews">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-brand">Reviews & reputation</h2>
        <span class="category-progress text-sm font-semibold text-text-muted" data-category-count="reviews">0 / 3</span>
      </div>
      <div class="space-y-3">
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="14" data-category="reviews">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Active review generation strategy</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Ask after every positive interaction. QR code on receipts works well for Guildford retail.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="15" data-category="reviews">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">All reviews replied to within two working days</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Respond to negative reviews professionally. Prospective clients read your responses.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="16" data-category="reviews">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Reviews collected on Google and sector sites, not just your own page</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Google does not show star ratings a business publishes about itself. Stars come from Google reviews and recognised third-party sites.</p>
              </details>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Citations & Links -->
    <div class="reveal" data-category="citations">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-brand">Citations & links</h2>
        <span class="category-progress text-sm font-semibold text-text-muted" data-category-count="citations">0 / 4</span>
      </div>
      <div class="space-y-3">
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="17" data-category="citations">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Listed in major UK directories (Yell, Thomson, FreeIndex)</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Consistency matters more than quantity. Ensure NAP matches GBP.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="18" data-category="citations">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Listed in Guildford-specific directories</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Surrey Chamber of Commerce, Visit Guildford, Experience Guildford, local business associations.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="19" data-category="citations">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Backlinks from local Guildford/Surrey sources</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Sponsor local events, join the chamber or business associations, and offer expertise to local press.</p>
              </details>
            </div>
          </label>
        </div>
        <div class="checklist-item service-card !p-0 overflow-hidden" data-id="20" data-category="citations">
          <label class="flex items-start gap-3 p-4 cursor-pointer select-none">
            <input type="checkbox" class="checklist-checkbox mt-1 w-5 h-5 rounded border-border accent-accent shrink-0" />
            <div class="flex-1">
              <span class="checklist-label font-semibold text-brand">Google Search Console and Bing Webmaster Tools set up</span>
              <details class="mt-2">
                <summary class="text-sm text-accent font-medium cursor-pointer hover:underline">View tip</summary>
                <p class="text-sm text-text-muted mt-1.5 leading-relaxed">Essential for monitoring indexation, clicks, and identifying technical issues.</p>
              </details>
            </div>
          </label>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Local SEO Matters in Guildford -->
  <section class="max-w-4xl mx-auto px-4 py-12 reveal">
    <h2 class="text-2xl font-bold text-brand mb-5">Why local SEO matters in Guildford</h2>
    <div class="prose max-w-none text-text-muted leading-relaxed space-y-4">
      <p>Guildford has a dense mix of independent shops, professional firms and service businesses competing for the same local searches. Three places decide who gets found: the Google local pack (the map with three listings), the organic results beneath it and AI answers such as Google AI Overviews and Copilot. Google documents that local ranking rests on relevance, distance and prominence. This checklist covers the parts you control. The technical items sit within my <a href="/technical-seo-guildford/">technical SEO service</a>. The <a href="/services/">services page</a> covers the rest.</p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto px-4 py-12 reveal">
    <h2 class="text-2xl font-bold text-brand mb-6">Frequently asked questions</h2>
    <div class="space-y-3">
      <details class="faq-item">
        <summary class="font-semibold text-brand cursor-pointer">How do I use this checklist?</summary>
        <p class="mt-3 text-text-muted leading-relaxed">Work through each category in order, starting with Google Business Profile. Tick each item as you complete it. Your progress saves automatically in your browser. You can return and pick up where you left off. Expand any item to see a practical tip specific to Guildford businesses. The progress bar at the top tracks your overall completion.</p>
      </details>
      <details class="faq-item">
        <summary class="font-semibold text-brand cursor-pointer">How many items should I complete?</summary>
        <p class="mt-3 text-text-muted leading-relaxed">All twenty help. The first ten (Google Business Profile and on-page) are the quickest to do and map directly to the relevance and prominence signals Google documents. Technical and citation items compound the gains over the following months.</p>
      </details>
      <details class="faq-item">
        <summary class="font-semibold text-brand cursor-pointer">Do I need professional help?</summary>
