---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://seo-guildford.uk/tools/" },
      { "@type": "ListItem", "position": 3, "name": "SEO ROI Calculator", "item": "https://seo-guildford.uk/tools/roi-calculator/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "SEO ROI Calculator, Estimate Your Return on SEO Investment",
    "description": "Free interactive SEO ROI calculator for Guildford and Surrey businesses. Enter your metrics to see projected revenue uplift, annual returns, and ROI percentage from organic search.",
    "url": "https://seo-guildford.uk/tools/roi-calculator/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How accurate is this SEO ROI calculator?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This calculator provides a directional estimate based on the inputs you supply. Real-world SEO performance depends on competition, content quality, technical health, and search algorithm updates. Use the figures as a planning baseline, not a guarantee. Then validate them with actual Google Search Console data once your campaign is running."
        }
      },
      {
        "@type": "Question",
        "name": "What is a good ROI from SEO?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There is no published UK benchmark I trust. Compare the projected uplift with the fee, then with what the same money buys in Google Ads clicks in your sector on my cost per click page. If the uplift does not clear the fee within a year on your own numbers, SEO may not be the right spend."
        }
      },
      {
        "@type": "Question",
        "name": "How long until I see ROI from SEO?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Google has to recrawl the changed pages before anything moves. I plan on three months before judging a plan and six before deciding whether to continue. Local pack changes often show before organic rankings."
        }
      }
    ]
  }
];
---

<Base
  title="SEO ROI Calculator: Estimate Your Return from SEO"
  description="Free SEO ROI calculator for Guildford and Surrey businesses. Enter your metrics to estimate projected revenue uplift, annual returns, and ROI."
  canonical="https://seo-guildford.uk/tools/roi-calculator/"
  schema={schema}
>

  <PageHero
    eyebrow="Free tool"
    crumbs={[{ label: "Tools", href: "/tools/" }, { label: "SEO ROI Calculator" }]}
    lead="Enter your numbers to estimate the revenue return from SEO."
    cta={null}
    compact={true}
  >
    <Fragment slot="title">SEO ROI Calculator</Fragment>
  </PageHero>

  <!-- Calculator -->
  <section class="max-w-6xl mx-auto px-6 pt-4 pb-16 reveal">
    <div class="service-card not-prose p-6 md:p-10">
      <div class="grid md:grid-cols-2 gap-10">

        <!-- Inputs -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-brand mb-6">Your business metrics</h2>

          <div class="space-y-6">
            <div>
              <label for="dealValue" class="block text-sm font-semibold text-brand mb-1">Average deal or order value (£)</label>
              <input type="number" id="dealValue" value="800" placeholder="e.g. 800" min="1" class="w-full rounded border border-border bg-surface-alt px-4 py-2.5 text-brand font-medium focus:outline-none focus:border-accent" />
            </div>

            <div>
              <label for="monthlyVisitors" class="block text-sm font-semibold text-brand mb-1">Monthly organic visitors</label>
              <input type="number" id="monthlyVisitors" value="400" placeholder="e.g. 400" min="0" class="w-full rounded border border-border bg-surface-alt px-4 py-2.5 text-brand font-medium focus:outline-none focus:border-accent" />
            </div>

            <div>
              <label for="conversionRate" class="block text-sm font-semibold text-brand mb-1">Current conversion rate: <span id="conversionDisplay" class="text-accent font-bold">1.5%</span></label>
              <input type="range" id="conversionRate" min="0.5" max="10" step="0.1" value="1.5" class="w-full accent-accent" />
              <div class="flex justify-between text-xs text-text-muted mt-1">
                <span>0.5%</span>
                <span>10%</span>
              </div>
            </div>

            <div>
              <label for="seoInvestment" class="block text-sm font-semibold text-brand mb-1">Monthly SEO investment (£)</label>
              <input type="number" id="seoInvestment" value="1000" placeholder="e.g. 1000" min="1" class="w-full rounded border border-border bg-surface-alt px-4 py-2.5 text-brand font-medium focus:outline-none focus:border-accent" />
            </div>

            <fieldset>
              <legend class="block text-sm font-semibold text-brand mb-2">Expected traffic growth</legend>
              <div class="flex flex-wrap gap-3">
                <label class="flex items-center gap-2 cursor-pointer bg-surface-alt border border-border rounded px-4 py-2 has-[:checked]:border-accent has-[:checked]:bg-accent/10 transition-colors">
                  <input type="radio" name="growth" value="50" checked class="accent-accent" />
                  <span class="text-sm font-medium text-brand">Conservative (50%)</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer bg-surface-alt border border-border rounded px-4 py-2 has-[:checked]:border-accent has-[:checked]:bg-accent/10 transition-colors">
                  <input type="radio" name="growth" value="100" class="accent-accent" />
                  <span class="text-sm font-medium text-brand">Moderate (100%)</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer bg-surface-alt border border-border rounded px-4 py-2 has-[:checked]:border-accent has-[:checked]:bg-accent/10 transition-colors">
                  <input type="radio" name="growth" value="200" class="accent-accent" />
                  <span class="text-sm font-medium text-brand">Aggressive (200%)</span>
                </label>
              </div>
            </fieldset>
          </div>
        </div>

        <!-- Outputs -->
        <div class="flex flex-col justify-center">
          <h2 class="text-2xl font-heading font-bold text-brand mb-6">Projected returns</h2>

          <div class="space-y-5">
            <div class="bg-surface-alt rounded p-4 border border-border">
              <p class="text-sm font-semibold text-text-muted mb-1.5">Current monthly revenue from organic</p>
              <p id="currentRevenue" class="font-mono text-3xl font-bold text-brand transition-colors duration-300">£4,800</p>
            </div>

            <div class="bg-surface-alt rounded p-4 border border-border">
              <p class="text-sm font-semibold text-text-muted mb-1.5">Projected monthly revenue</p>
              <p id="projectedRevenue" class="font-mono text-3xl font-bold text-brand transition-colors duration-300">£7,200</p>
            </div>

            <div class="bg-surface-alt rounded p-4 border border-border">
              <p class="text-sm font-semibold text-text-muted mb-1.5">Monthly revenue uplift</p>
              <p id="monthlyUplift" class="font-mono text-3xl font-bold text-accent transition-colors duration-300">+£2,400</p>
            </div>

            <div class="bg-surface-alt rounded p-4 border border-border">
              <p class="text-sm font-semibold text-text-muted mb-1.5">Annual revenue uplift</p>
              <p id="annualUplift" class="font-mono text-3xl font-bold text-accent transition-colors duration-300">+£28,800</p>
            </div>

            <div class="bg-surface-alt rounded p-5 border border-accent">
              <p class="text-sm font-semibold text-text-muted mb-1.5">Return on Investment</p>
              <p id="roiPercent" class="font-mono text-4xl font-extrabold text-accent transition-colors duration-300">140%</p>
            </div>
          </div>
          <p class="text-sm text-text-muted mt-4">This estimates revenue, not profit. The growth rates are assumptions you choose, not forecasts. The result depends on your own numbers.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Prose -->
  <section class="max-w-6xl mx-auto px-6 pb-16 reveal">
    <div class="prose" style="max-width:46rem">
      <h2 class="font-heading text-brand">Why work out SEO return</h2>
      <p>SEO return is easier to judge when you start from your own numbers. Deal value, visitors and conversion rate decide what extra traffic is worth. The calculator above turns those into a revenue figure you can compare with a monthly budget.</p>
      <p>Organic rankings build over time. Paid search stops when you stop paying. I list <a href="/cost-per-click/">what a Google Ads click costs in Guildford</a> for 78 local services (71 with a click price).</p>
      <p>The result is an estimate of revenue, not profit. Change the growth rate to see how sensitive the answer is.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-6xl mx-auto px-6 pb-16 reveal"><div style="max-width:46rem">
    <h2 class="text-2xl font-heading font-bold text-brand mb-6">Frequently asked questions</h2>
    <div class="space-y-3">
      <details class="faq-item">
        <summary class="font-heading font-semibold text-brand">How accurate is this SEO ROI calculator?</summary>
        <div class="pt-3 text-text-muted">
          <p>This calculator provides a directional estimate based on the inputs you supply. Real-world SEO performance depends on competition, content quality, technical health, and search algorithm updates. Use the figures as a planning baseline, not a guarantee. Then validate them with actual Google Search Console data once your campaign is running.</p>
        </div>
      </details>
      <details class="faq-item">
        <summary class="font-heading font-semibold text-brand">What is a good ROI from SEO?</summary>
        <div class="pt-3 text-text-muted">
          <p>There is no published UK benchmark I trust. Compare the projected uplift with the fee, then with what the same money buys in Google Ads clicks in your sector on my <a href="/cost-per-click/">cost per click page</a>. If the uplift does not clear the fee within a year on your own numbers, SEO may not be the right spend.</p>
        </div>
      </details>
      <details class="faq-item">
        <summary class="font-heading font-semibold text-brand">How long until I see ROI from SEO?</summary>
        <div class="pt-3 text-text-muted">
          <p>Google has to recrawl the changed pages before anything moves. I plan on three months before judging a plan and six before deciding whether to continue. Local pack changes often show before organic rankings.</p>
        </div>
      </details>
    </div>
  </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="sheet" style="max-width:46rem">
      <h2 class="font-heading text-brand" style="font-size:1.4rem;margin:0 0 0.5rem">Want these numbers checked against your own site?</h2>
      <p class="text-text-muted" style="margin:0 0 1.1rem">A free audit shows where the growth opportunities are. It is free and there is no obligation.</p>
      <a href="/free-audit/" class="cta-button">Book my free audit</a>
    </div>
    <p class="related">Related tools: <a href="/tools/ai-search-readiness-checker/">AI Search Readiness Checker</a>, <a href="/tools/local-seo-checklist/">Local SEO Checklist</a> and <a href="/tools/">all tools</a>.</p>
  </section>

  <!-- Calculator JS -->
  <script>
    function formatCurrency(n) {
      return '£' + Math.round(n).toLocaleString('en-GB');
    }

    function calculate() {
      const dealValue = parseFloat((document.getElementById('dealValue') as HTMLInputElement).value) || 0;
      const visitors = parseFloat((document.getElementById('monthlyVisitors') as HTMLInputElement).value) || 0;
      const conversion = parseFloat((document.getElementById('conversionRate') as HTMLInputElement).value) || 0;
      const investment = parseFloat((document.getElementById('seoInvestment') as HTMLInputElement).value) || 0;
      const growthRadio = document.querySelector('input[name="growth"]:checked') as HTMLInputElement;
      const growth = growthRadio ? parseFloat(growthRadio.value) : 50;

      const currentRevenue = visitors * (conversion / 100) * dealValue;
      const projectedRevenue = (visitors * (1 + growth / 100)) * (conversion / 100) * dealValue;
      const monthlyUplift = projectedRevenue - currentRevenue;
      const annualUplift = monthlyUplift * 12;
      const roi = investment > 0 ? ((monthlyUplift - investment) / investment) * 100 : 0;

      const els = {
        currentRevenue: document.getElementById('currentRevenue'),
        projectedRevenue: document.getElementById('projectedRevenue'),
        monthlyUplift: document.getElementById('monthlyUplift'),
        annualUplift: document.getElementById('annualUplift'),
        roiPercent: document.getElementById('roiPercent'),
        conversionDisplay: document.getElementById('conversionDisplay'),
      };

      if (els.currentRevenue) els.currentRevenue.textContent = formatCurrency(currentRevenue);
      if (els.projectedRevenue) els.projectedRevenue.textContent = formatCurrency(projectedRevenue);
      if (els.monthlyUplift) els.monthlyUplift.textContent = '+' + formatCurrency(monthlyUplift);
      if (els.annualUplift) els.annualUplift.textContent = '+' + formatCurrency(annualUplift);
      if (els.roiPercent) els.roiPercent.textContent = Math.round(roi).toLocaleString('en-GB') + '%';
      if (els.conversionDisplay) els.conversionDisplay.textContent = conversion.toFixed(1) + '%';
    }

    // Bind all inputs
    document.querySelectorAll('#dealValue, #monthlyVisitors, #conversionRate, #seoInvestment').forEach(el => {
      el.addEventListener('input', calculate);
    });
    document.querySelectorAll('input[name="growth"]').forEach(el => {
      el.addEventListener('change', calculate);
    });

    // Initial calc
    calculate();
  </script>

  <ContactForm eyebrow="Enquire" heading="Prefer a human read?" subject="SEO Guildford: ROI tool enquiry" />
</Base>
