---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import ChecklistFigure from '../components/ChecklistFigure.astro';

const title = "About SEO Guildford: Guildford Search Consultancy";
const description = "I am a solo SEO consultant for Guildford, Surrey and Hampshire. Technical SEO, content and AI search, working from Search Console and Bing data, with prices on every page.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://seo-guildford.uk/about/" }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": "https://seo-guildford.uk/about/",
  "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk" }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SEO Guildford",
  "legalName": "ND Media Ltd",
  "identifier": "10784524",
  "url": "https://seo-guildford.uk",
  "email": "hello@seo-guildford.uk",
  "sameAs": ["https://find-and-update.company-information.service.gov.uk/company/10784524"],
  "areaServed": [
    { "@type": "City", "name": "Guildford" },
    { "@type": "AdministrativeArea", "name": "Surrey" },
    { "@type": "AdministrativeArea", "name": "Hampshire" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What methodology do you follow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every engagement begins with a thorough technical audit and competitive analysis grounded in first-party data from Google Search Console and Bing Webmaster Tools. I prioritise technical foundations, crawl efficiency, structured data, Core Web Vitals, before addressing content and authority. Recommendations are evidence-based, not speculative, and each action is measured against commercial outcomes rather than vanity metrics."
      }
    },
    {
      "@type": "Question",
      "name": "How do you work with Guildford businesses?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Remotely, by video call and email. I audit first. Then I fix what I can reach or write exact specifications for your developer. I report monthly on enquiries as well as rankings."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with clients outside Surrey?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. My primary service area encompasses Guildford, Woking, Godalming, Farnham, Camberley, and Cobham. I operate remote-first and serve clients nationally and internationally. Communication takes place by video call, email and a monthly written report, with the same standard of service regardless of location."
      }
    },
    {
      "@type": "Question",
      "name": "What distinguishes you from larger agencies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I am a solo consultant, not a volume agency. There is no account manager layer. There are no junior staff learning on your account. There are no templated deliverables. Every recommendation is drawn from your specific data, your competitive landscape, and your commercial objectives. The person who diagnoses the problem is the person who implements the solution."
      }
    },
    {
      "@type": "Question",
      "name": "How do you stay current with algorithm changes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I run my own portfolio of sites across several sectors. I see every Google and Bing update in live data rather than reading about it. I check Search Console and Bing Webmaster Tools daily and test AI tools against a fixed prompt set."
      }
    }
  ]
};

const schema = [breadcrumbSchema, webPageSchema, orgSchema, faqSchema];
---

<Base title={title} description={description} canonical="https://seo-guildford.uk/about/" schema={schema} ogType="website">
<PageHero
    eyebrow="About"
    crumbs={[{"label": "About"}]}
    lead="SEO Guildford is my search consultancy for businesses in Guildford, Surrey and Hampshire. I work on visibility in Google, Bing and AI search tools. I work directly with business owners."
    glance={{"heading": "At a glance", "points": ["Remote-first search consultancy for Guildford and Surrey.", "Built on first-party data from Google Search Console and Bing Webmaster Tools.", "No account-manager layer and no outsourced delivery.", "The person who diagnoses the problem implements the fix."], "facts": [{"k": "Registered office", "v": "Reading"}, {"k": "Service area", "v": "Guildford, Surrey and Hampshire"}, {"k": "Setup", "v": "Solo consultant, remote-first"}, {"k": "Free audit report", "v": "2 to 3 working days, PDF by email"}, {"k": "Company", "v": "ND Media Ltd, no. 10784524", "href": "https://find-and-update.company-information.service.gov.uk/company/10784524"}]}}
    tools={false}
    photo={{"src": "/images/guildford-high-street.jpg", "alt": "Timber-framed buildings on Guildford High Street", "credit": "Photo: 46 High Street, Guildford by Tim Sheerman-Chase, CC BY 2.0, via Wikimedia Commons.", "creditHref": "https://commons.wikimedia.org/wiki/File:46_High_Street,_Guildford_(side).jpg"}}
  >
    <Fragment slot="title">About SEO <span class="mark">Guildford</span></Fragment>
  </PageHero>

  <section class="doc">
    <div class="prose">
      <div class="reveal">
      <h2>My philosophy</h2>

      <p>I believe that effective search optimisation begins with honest assessment and ends with commercial impact. The work needs technical knowledge and patience. I check my own assumptions as well as yours. SEO is ongoing work: results build over time, and shortcuts usually cost more than they save.</p>

      <p>My methodology is grounded in first-party data. I conduct a thorough technical audit before any strategy takes shape. I analyse search console data across both Google and Bing. I map the competitors in your market. Recommendations emerge from evidence, not convention. Every action I take is calibrated against a single question: will this generate revenue, leads, or bookings that justify the investment?</p>

      <FlowDiagram title="How I decide what to do" steps={[{"t": "Technical audit", "d": "Before any strategy takes shape"}, {"t": "Search console data", "d": "Across both Google and Bing"}, {"t": "Competitor map", "d": "The competitors in your market"}, {"t": "Revenue question", "d": "Will this generate revenue, leads or bookings?"}]} caption="Recommendations come from evidence, not convention." />

      <p>This approach reflects a broader conviction. Rankings and traffic are intermediate signals, necessary but insufficient. Impressions without clicks, rankings for terms that never convert and traffic that fails to translate into enquiries are vanity metrics. I identify and deprioritise them early. What matters is the commercial outcome. I structure every engagement around that principle.</p>
      </div>

      <div class="reveal">
      <h2>Why Guildford</h2>

      <p>Guildford is not a typical market. I did not choose it arbitrarily. The town combines an affluent consumer base with a technically literate business community. That community understands digital marketing in broad terms but often lacks the specialist in-house SEO capability required to compete effectively.</p>

      <p>Surrey Research Park, next to the University of Surrey, houses research-led companies in satellites, software, biotech and AI. They have complex products, long sales cycles and search patterns that need specialist handling. The same is true of the professional services firms along Guildford High Street. It is also true of the solicitors, accountants and consultancies serving the wider Surrey corridor. The <a href="/industries/">industries page</a> shows how the approach changes by sector.</p>

      <p>Guildford's games studios add a creative and technology workforce that expects a high technical standard from suppliers. I welcome that.</p>

      <p>Beyond the town itself, the surrounding communities of Woking, Godalming, Farnham, Camberley, and Cobham extend my natural catchment. Each possesses its own commercial character. They share proximity to the A3 and M25 corridors and a customer base that researches online before making purchasing decisions. Local search visibility is not an optional enhancement for service businesses in this region. It is the primary acquisition channel.</p>

      <ChecklistFigure title="Towns around Guildford I cover" items={["Woking", "Godalming", "Farnham", "Camberley", "Cobham"]} caption="My natural catchment beyond the town. I also serve clients nationally." />

      </div>

      <div class="reveal">
      <h2>My approach</h2>

      <p>I structure my work around three interconnected disciplines. Technical soundness creates the conditions for content to perform. Content performance generates the authority signals that strengthen technical standing. AI-search readiness helps you stay visible on the platforms that are increasingly mediating the relationship between businesses and their prospective customers.</p>

      <h3>Technical-first</h3>

      <p>I check the technical layer first because a site Google cannot crawl or render caps everything else, however good the writing.</p>

      <p>In practice, this means examining crawl budgets, indexation patterns, internal linking architecture, structured data validity, Core Web Vitals scores, and server response behaviour. These are not optional refinements to be considered once content strategy is in place. All later work depends on them.</p>

      <ChecklistFigure title="What a technical review examines" items={["Crawl budgets", "Indexation patterns", "Internal linking architecture", "Structured data validity", "Core Web Vitals scores", "Server response behaviour"]} caption="Technical work comes first because all later work depends on it." />

      <h3>AI-search aware</h3>

      <p>I build AI search readiness into every engagement: consistent business facts, structured data that matches the page, and pages written so the answer can be quoted. Detail is on my <a href="/ai-search-optimisation/">AI search optimisation</a> page.</p>

      <ChecklistFigure title="AI search readiness in every engagement" items={["Entity optimisation", "Structured data AI systems can parse", "Content built for extraction and citation", "Positioning as a trusted source"]} caption="Built into every engagement." />

      <h3>Transparent reporting</h3>

      <p>I do not produce reports filled with jargon designed to obscure a lack of progress. My reporting covers what was done, what changed as a consequence, and what I intend to do next. Google Search Console and Bing Webmaster Tools data is shared directly. Questions are answered promptly and candidly. I will raise anything that is not working before you need to ask.</p>
      </div>

      <div class="reveal">
      <h2>What I specialise in</h2>

      <div class="grid md:grid-cols-2 gap-4 not-prose my-8">
        <a href="/technical-seo-guildford/" class="service-card reveal block" style="--reveal-delay: 0.08s">
          <span class="eyebrow block mb-2">01</span>
          <h3 class="font-semibold text-brand text-lg mb-2">Technical SEO</h3>
          <p class="text-text-muted text-sm">Site architecture, crawl optimisation, Core Web Vitals, structured data, indexation management, and migration support.</p>
        </a>
        <a href="/ai-search-optimisation/" class="service-card reveal block" style="--reveal-delay: 0.16s">
          <span class="eyebrow block mb-2">02</span>
          <h3 class="font-semibold text-brand text-lg mb-2">AI search optimisation</h3>
          <p class="text-text-muted text-sm">AEO and GEO strategies that position your brand for citations in ChatGPT, Perplexity, Google AI Overviews, and Copilot. Entity-first, data-structured, citation-driven.</p>
        </a>
        <a href="/services/" class="service-card reveal block" style="--reveal-delay: 0.24s">
          <span class="eyebrow block mb-2">03</span>
          <h3 class="font-semibold text-brand text-lg mb-2">Local SEO</h3>
          <p class="text-text-muted text-sm">Google Business Profile optimisation, local pack rankings, location-page strategy, review management, and citation building for Guildford and Surrey businesses.</p>
        </a>
        <a href="/services/" class="service-card reveal block" style="--reveal-delay: 0.32s">
          <span class="eyebrow block mb-2">04</span>
          <h3 class="font-semibold text-brand text-lg mb-2">Content strategy</h3>
          <p class="text-text-muted text-sm">Topical authority mapping, keyword clustering, content briefs, and editorial calendars built around search demand and competitive gaps. Every page earns its place.</p>
        </a>
        <a href="/services/" class="service-card reveal block md:col-span-2" style="--reveal-delay: 0.40s">
          <span class="eyebrow block mb-2">05</span>
          <h3 class="font-semibold text-brand text-lg mb-2">E-commerce SEO</h3>
          <p class="text-text-muted text-sm">Product page optimisation, faceted navigation handling, category architecture, and structured data for rich results. Built for platforms from Shopify to custom builds.</p>
        </a>
      </div>

      <p>Full details of all available services are on the <a href="/services/">services page</a>.</p>
      </div>

      <div class="reveal">
      <h2>Working with me</h2>

      <p>The process is straightforward. I believe clarity at the outset prevents friction later. An initial conversation establishes your goals, current performance, and competitive position. When there is a mutual fit, I provide a proposal within two working days. It outlines scope, deliverables, timeline, and pricing. There is no ambiguity and there are no hidden costs.</p>

      <h3>Communication</h3>

      <p>I value directness and efficiency in equal measure. You will have a direct line to me, not a support queue. Updates are regular but not excessive. I will raise anything that requires your attention. I will not send unnecessary status emails while work is progressing as planned. My prices sit next to eight published price guides in the <a href="/cost/">UK SEO cost guide</a>.</p>

      <h3>What my clients can expect</h3>

      <p>A clear plan of action within the first fortnight. Technical issues identified and prioritised by commercial impact. Content recommendations substantiated by search demand data. Monthly reporting that addresses the metrics you care about, rankings, traffic, conversions, and revenue. Monthly plans have a three-month initial term. They then run month to month with 30 days' notice.</p>

      <ChecklistFigure title="What my clients can expect" items={["A clear plan of action in the first fortnight", "Issues prioritised by commercial impact", "Content recommendations backed by search demand data", "Monthly reporting on rankings, traffic, conversions and revenue"]} caption="Reporting covers what was done, what changed and what comes next." />

      <p>Many engagements begin with a <a href="/free-audit/">free SEO audit</a> that identifies the highest-impact opportunities before any commitment is made.</p>
      </div>

      <div class="reveal">
      <h2>Experience and credentials</h2>

      <p>I have worked in SEO for 16 years, in agencies, in-house and as a consultant, across professional services, e-commerce, health and wellness, property, education and technology.</p>

      <p>My technical toolkit includes Google Search Console, Bing Webmaster Tools, Ahrefs, Screaming Frog, and programmatic SEO tooling. I've worked hands-on across sites ranging from small service businesses to large, complex platforms. Structured data implementation, site migrations, penalty recovery, and core update response all fall within my regular scope of work.</p>

      <p>I track how AI tools select and cite sources on my own sites. I test entity and page changes against a fixed set of prompts. That informs what I recommend.</p>

      <p>Guildford businesses deserve a consultant who understands both the local market and the technical landscape. That is what I provide.</p>
      </div>

      <div class="reveal">
      <h2>Frequently asked questions</h2>

      <details class="faq-item">
        <summary>What methodology do you follow?</summary>
        <p>Every engagement begins with a thorough technical audit and competitive analysis grounded in first-party data from Google Search Console and Bing Webmaster Tools. I prioritise technical foundations, crawl efficiency, structured data, Core Web Vitals, before addressing content and authority. Recommendations are evidence-based, not speculative, and each action is measured against commercial outcomes rather than vanity metrics.</p>
      </details>

      <details class="faq-item">
        <summary>How do you work with Guildford businesses?</summary>
        <p>Remotely, by video call and email. I audit first. Then I fix what I can reach or write exact specifications for your developer. I report monthly on enquiries as well as rankings.</p>
      </details>

      <details class="faq-item">
        <summary>Do you work with clients outside Surrey?</summary>
        <p>Yes. My primary service area encompasses Guildford, Woking, Godalming, Farnham, Camberley, and Cobham. I operate remote-first and serve clients nationally and internationally. Communication takes place by video call, email and a monthly written report, with the same standard of service regardless of location.</p>
      </details>

      <details class="faq-item">
        <summary>What distinguishes you from larger agencies?</summary>
        <p>I am a solo consultant, not a volume agency. There is no account manager layer. There are no junior staff learning on your account. There are no templated deliverables. Every recommendation is drawn from your specific data, your competitive landscape, and your commercial objectives. The person who diagnoses the problem is the person who implements the solution.</p>
      </details>

      <details class="faq-item">
        <summary>How do you stay current with algorithm changes?</summary>
        <p>I run my own portfolio of sites across several sectors. I see every Google and Bing update in live data rather than reading about it. I check Search Console and Bing Webmaster Tools daily and test AI tools against a fixed prompt set.</p>
      </details>
      </div>

      <div class="not-prose mt-12 bg-surface-alt border border-border rounded-[0.35rem] p-8 reveal">
        <p class="eyebrow mb-3">Get Started</p>
        <h2 class="text-2xl font-bold text-brand mb-3">Ready to improve your search visibility?</h2>
        <p class="text-text-muted mb-6 max-w-lg">I would welcome the opportunity to discuss your search objectives. No sales pitch, no obligations, simply a clear assessment of where you stand and what is achievable.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact/" class="cta-button">Start with an audit</a>
          <a href="/free-audit/" class="cta-button-outline">Free SEO Audit</a>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-border text-sm text-text-muted">
        <p>Explore more: <a href="/">Home</a> · <a href="/services/">Services</a> · <a href="/ai-search-optimisation/">AI Search Optimisation</a> · <a href="/case-studies/">Results</a> · <a href="/areas/">Areas I cover</a></p>
      </div>
    </div>
  </section>
  <ContactForm eyebrow="Enquire" heading="Work with me directly" subject="SEO Guildford: About page enquiry" />
</Base>
