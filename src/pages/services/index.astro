---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import ProofStats from '../../components/ProofStats.astro';
import ChecklistFigure from '../../components/ChecklistFigure.astro';

const title = "SEO Services Guildford: Technical, Local & AI";
const description = "SEO services for Guildford businesses covering technical SEO, local visibility, content strategy, AI search optimisation, and measured implementation.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://seo-guildford.uk/services/" }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": "https://seo-guildford.uk/services/",
  "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which SEO service should I start with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I recommend beginning with an SEO audit, as it identifies technical issues, content gaps, and competitive weaknesses specific to your position in the Guildford market. Every other service, content, technical remediation, link building, is then prioritised based on what the audit reveals. If budget is tight, my free SEO audit gives you a useful starting overview."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need local SEO or national SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "That depends entirely on where your customers are. A solicitor on Guildford High Street needs local SEO to achieve prominence in the map pack. A SaaS company at Surrey Research Park selling nationally needs broader organic visibility. Many Guildford businesses, in practice, need both, local presence alongside wider reach, the way a tree needs roots and branches in equal measure. The audit process clarifies which mix delivers the most favourable return."
      }
    },
    {
      "@type": "Question",
      "name": "What is AI search optimisation and do I need it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI search optimisation ensures your business appears in answers generated by Google AI Overviews, ChatGPT, Perplexity, and similar tools. Many customers research purchases online. For them AI search visibility is becoming as important as traditional rankings. Read more on my AI search optimisation page."
      }
    },
    {
      "@type": "Question",
      "name": "How do you handle link building for Guildford businesses?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "I build links through local citations, industry directories, partnerships with Guildford organisations, digital PR, and content-driven outreach. I never purchase links or use private blog networks. Every link is earned from relevant, authoritative sources that genuinely strengthen your domain authority and local relevance."
      }
    },
    {
      "@type": "Question",
      "name": "Can I combine multiple SEO services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Most of my clients do. A typical engagement combines technical SEO, content strategy, and local SEO into a monthly retainer, with the mix tailored to your audit results and business objectives. See my pricing page for retainer options."
      }
    },
    {
      "@type": "Question",
      "name": "Is Google Business Profile management included in an SEO retainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Google Business Profile management is typically bundled into local SEO and full-service retainers rather than sold as a separate line item. It covers profile optimisation, category selection, post scheduling, review management strategy, and photo guidelines, the elements search engines use to build trust in local pack rankings."
      }
    },
    {
      "@type": "Question",
      "name": "Does content strategy include writing the content itself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Content strategy sets the direction. That means topic clusters, keyword targets and an editorial calendar. Content creation is the writing and publishing that follows the plan. Many SEO services bundle both together, since a content strategy without production delivers no ranking value on its own."
      }
    }
  ]
};

const schema = [breadcrumbSchema, webPageSchema, faqSchema];
---
<Base title={title} description={description} schema={schema}>

<PageHero
    eyebrow="SEO services &middot; serving Guildford and Surrey"
    crumbs={[{"label": "Services"}]}
    lead="I offer technical SEO, content strategy, local SEO, link building and AI search optimisation. You can hire me for one service or all of them. I do the work myself."
    glance={{"heading": "At a glance", "points": ["Technical SEO, SEO audits and AI search optimisation.", "Local SEO and Google Business Profile management.", "Content strategy and link building.", "A free SEO audit is the recommended starting point before a retainer."], "facts": [{"k": "Audits and plans", "v": "Audits from £400. Plans from £500 a month"}, {"k": "Monthly plans", "v": "Three-month initial term. Then month to month with 30 days' notice"}, {"k": "Service area", "v": "Guildford, Surrey and Hampshire"}, {"k": "Reply time", "v": "Within one working day"}, {"k": "Company", "v": "ND Media Ltd, no. 10784524", "href": "https://find-and-update.company-information.service.gov.uk/company/10784524"}]}}
    tools={false}
  >
    <Fragment slot="title">SEO Services for <span class="mark">Guildford</span> and Surrey Businesses</Fragment>
  </PageHero>

  <article class="doc">
  <div class="prose">

    <h2>Core SEO services</h2>

    <p>You can hire me for one service or combine several. I do the work myself.</p>

    <div class="sheet-grid cols-3 not-prose my-8 reveal">
      <a href="/technical-seo-guildford/" class="service-card sheet-link"><span class="sheet-tag">Audit &pound;500</span><h3>Technical SEO</h3><p>Crawling, indexing, Core Web Vitals and structured data, fixed in order of impact.</p><span class="sheet-more">See the technical SEO service &rarr;</span></a>
      <a href="/seo-audit-guildford/" class="service-card sheet-link"><span class="sheet-tag">Comprehensive audit &pound;750</span><h3>SEO audit</h3><p>Technical, content, backlink and competitor review. The starting point for most work.</p><span class="sheet-more">See the SEO audit &rarr;</span></a>
      <a href="/ai-search-optimisation-guildford/" class="service-card sheet-link"><span class="sheet-tag">AI search audit &pound;400</span><h3>AI search optimisation</h3><p>How Google AI Overviews, ChatGPT, Perplexity and Copilot describe your business.</p><span class="sheet-more">See the AI search service &rarr;</span></a>
      <a href="/free-seo-audit-guildford/" class="service-card sheet-link"><span class="sheet-tag">Free</span><h3>Free SEO audit</h3><p>A short review of technical health, keyword opportunities and competitor gaps. No obligation.</p><span class="sheet-more">Request the free audit &rarr;</span></a>
      <a href="/seo-pricing-guildford/" class="service-card sheet-link"><span class="sheet-tag">Plans from &pound;500 a month</span><h3>SEO pricing</h3><p>Fixed-fee projects and monthly plans, with prices set out in full.</p><span class="sheet-more">See SEO pricing &rarr;</span></a>
      <a href="#local-seo" class="service-card sheet-link"><span class="sheet-tag">Included from £500 a month</span><h3>Local SEO and Google Business Profile</h3><p>Map pack visibility through profile work, citations and reviews.</p><span class="sheet-more">See the details below &darr;</span></a>
    </div>

    <div class="reveal">
    <h2 id="local-seo">Local SEO</h2>

    <p>Local SEO wins the searches with the clearest buying intent. It decides which businesses appear in the map pack and earn the enquiry.</p>

    <p>I cover Google Business Profile optimisation, citations, review strategy, location pages and map pack ranking factors. I target explicit searches like "solicitor guildford". I also target implicit ones where Google applies a local filter. For several branches I build location pages and manage one profile for each. My <a href="/areas/">areas page</a> lists the locations I target.</p>
    </div>

    <div class="reveal">
    <h2>Content strategy</h2>

    <p>Content strategy means researching what your customers search for, planning the pages and improving them over time.</p>

    <p>I map your topics and find gaps against competitors. You get a prioritised editorial calendar. Each piece targets a keyword cluster and supports your site structure. I write for search and for AI citation with structured data, clear entity definitions and concise answers.</p>
    </div>

    <div class="reveal">
    <h2>Link building</h2>

    <p>I earn links through digital PR, content outreach, local organisations and genuine directories.</p>

    <p>I also pursue national and sector links that build authority on your topics. I never buy links or use private blog networks. Manipulative links carry more risk than reward.</p>
    </div>

    <div class="reveal">
    <h2>Google Business Profile management</h2>

    <p>Your Google Business Profile is often the first thing a customer sees. It appears before they reach your website.</p>

    <p>I handle optimisation, category selection, post scheduling, review strategy, Q&amp;A monitoring and photo guidelines. Regular updates show Google that the business is active.</p>

    <ChecklistFigure title="What Google Business Profile management covers" items={["Optimisation","Category selection","Post scheduling","Review strategy","Q&A monitoring","Photo guidelines"]} caption="Regular updates show Google that the business is active." />
    </div>

    <div class="reveal">
    <h2>Why Guildford businesses need specialist SEO</h2>

    <p>Guildford is a regional business centre with strong competition. Many firms there already invest in digital marketing.</p>

    <p>Remote agencies without local context miss the detail. A dental practice in one part of town competes differently from one in another. Some businesses also need national SEO alongside local presence.</p>

    <p>I work remote-first. My advice rests on current Guildford search data, competitor review and first-party analytics. I do not claim a Guildford office. You can read <a href="/about/">about the consultancy and working process</a>.</p>
    </div>

    <div class="reveal">
    <h2>Frequently asked questions</h2>

    <div class="not-prose">
      <details class="faq-item" style="--reveal-delay: 0.1s">
        <summary>Which SEO service should I start with?</summary>
        <div class="faq-answer">
          <p>I recommend beginning with an <a href="/seo-audit-guildford/" class="text-brand underline">SEO audit</a>, as it identifies technical issues, content gaps, and competitive weaknesses specific to your position in the Guildford market. Every other service, content, technical remediation, link building, is then prioritised based on what the audit reveals. If budget is tight, my <a href="/free-seo-audit-guildford/" class="text-brand underline">free SEO audit</a> gives you a useful starting overview.</p>
        </div>
      </details>

      <details class="faq-item" style="--reveal-delay: 0.18s">
        <summary>Do I need local SEO or national SEO?</summary>
        <div class="faq-answer">
          <p>That depends entirely on where your customers are. A solicitor on Guildford High Street needs local SEO to achieve prominence in the map pack. A SaaS company at Surrey Research Park selling nationally needs broader organic visibility. Many Guildford businesses, in practice, need both, local presence alongside wider reach, the way a tree needs roots and branches in equal measure. The audit process clarifies which mix delivers the most favourable return.</p>
        </div>
      </details>

      <details class="faq-item" style="--reveal-delay: 0.26s">
        <summary>What is AI search optimisation and do I need it?</summary>
        <div class="faq-answer">
          <p>AI search optimisation ensures your business appears in answers generated by Google AI Overviews, ChatGPT, Perplexity, and similar tools. Many customers research purchases online. For them AI search visibility is becoming as important as traditional rankings. Read more on my <a href="/ai-search-optimisation-guildford/" class="text-brand underline">AI search optimisation page</a>.</p>
        </div>
      </details>

      <details class="faq-item" style="--reveal-delay: 0.34s">
        <summary>How do you handle link building for Guildford businesses?</summary>
        <div class="faq-answer">
          <p>I build links through local citations, industry directories, partnerships with Guildford organisations, digital PR, and content-driven outreach. I never purchase links or use private blog networks. Every link is earned from relevant, authoritative sources that genuinely strengthen your domain authority and local relevance.</p>
        </div>
      </details>

      <details class="faq-item" style="--reveal-delay: 0.42s">
        <summary>Can I combine multiple SEO services?</summary>
        <div class="faq-answer">
          <p>Yes. Most of my clients do. A typical engagement combines technical SEO, content strategy, and local SEO into a monthly retainer, with the mix tailored to your audit results and business objectives. See my <a href="/seo-pricing-guildford/" class="text-brand underline">pricing page</a> for retainer options.</p>
        </div>
      </details>

      <details class="faq-item" style="--reveal-delay: 0.5s">
        <summary>Is Google Business Profile management included in an SEO retainer?</summary>
        <div class="faq-answer">
          <p>Google Business Profile management is typically bundled into local SEO and full-service retainers rather than sold as a separate line item. It covers profile optimisation, category selection, post scheduling, review management strategy, and photo guidelines, the elements search engines use to build trust in local pack rankings.</p>
        </div>
      </details>

      <details class="faq-item" style="--reveal-delay: 0.58s">
        <summary>Does content strategy include writing the content itself?</summary>
        <div class="faq-answer">
          <p>Content strategy sets the direction. That means topic clusters, keyword targets and an editorial calendar. Content creation is the writing and publishing that follows the plan. Many SEO services bundle both together, since a content strategy without production delivers no ranking value on its own.</p>
        </div>
      </details>
    </div>
    </div>
  </div>
  </article>

  <!-- CTA -->
  <section class="cta-section">
    <div class="max-w-3xl mx-auto px-4 py-16 md:py-20 text-center relative z-10 reveal">
      <h2 class="text-2xl md:text-3xl font-bold text-brand mb-4">See where you stand</h2>
      <p class="text-text-muted text-lg mb-8">Get your free audit and receive a clear assessment of your Guildford market position, technical health, and growth opportunities.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/free-seo-audit-guildford/" class="cta-button">Start with an audit</a>
        <a href="/contact/" class="cta-button-outline">Get in touch</a>
      </div>
    </div>
  </section>

  <ProofStats variant="full" />

  <ContactForm eyebrow="Services" heading="Discuss a project" subject="SEO Guildford: Services enquiry" />

</Base>
