---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://seo-guildford.uk/services/" },
      { "@type": "ListItem", "position": 3, "name": "Pricing", "item": "https://seo-guildford.uk/pricing/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "SEO Pricing Guildford",
    "description": "Transparent SEO pricing for Guildford and Surrey businesses. Monthly retainers from £500. One-off audits from £400. No hidden fees.",
    "url": "https://seo-guildford.uk/pricing/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "SEO Services Guildford",
    "provider": {
      "@type": "Organization",
      "name": "SEO Guildford",
      "legalName": "ND Media Ltd",
      "url": "https://seo-guildford.uk/",
      "email": "hello@seo-guildford.uk",
      "sameAs": ["https://find-and-update.company-information.service.gov.uk/company/10784524"],
      "areaServed": { "@type": "City", "name": "Guildford" }
    },
    "areaServed": { "@type": "City", "name": "Guildford", "containedInPlace": { "@type": "AdministrativeArea", "name": "Surrey" } },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "SEO Pricing Plans",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Starter SEO Plan",
          "description": "Technical audit, monthly reporting, 1-2 keyword clusters, local SEO basics, Google Business Profile optimisation.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "500", "priceCurrency": "GBP", "unitText": "month", "referenceQuantity": { "@type": "QuantitativeValue", "value": "1", "unitCode": "MON" } }
        },
        {
          "@type": "Offer",
          "name": "Growth SEO Plan",
          "description": "Everything in Starter plus content strategy, 3-5 keyword clusters, link building, and monthly strategy calls.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "1000", "priceCurrency": "GBP", "unitText": "month", "referenceQuantity": { "@type": "QuantitativeValue", "value": "1", "unitCode": "MON" } }
        },
        {
          "@type": "Offer",
          "name": "Premium SEO Plan",
          "description": "Everything in Growth plus AI search optimisation, competitor monitoring, conversion rate optimisation, and bi-weekly calls.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "2000", "priceCurrency": "GBP", "unitText": "month", "referenceQuantity": { "@type": "QuantitativeValue", "value": "1", "unitCode": "MON" } }
        },
        {
          "@type": "Offer",
          "name": "Enterprise SEO Plan",
          "description": "Everything in Premium plus multi-location SEO, custom reporting dashboards, and weekly calls.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "3500", "priceCurrency": "GBP", "unitText": "month", "referenceQuantity": { "@type": "QuantitativeValue", "value": "1", "unitCode": "MON" } }
        },
        {
          "@type": "Offer",
          "name": "Comprehensive SEO Audit",
          "description": "Comprehensive technical and strategic SEO audit with prioritised action plan.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "750", "priceCurrency": "GBP" }
        },
        {
          "@type": "Offer",
          "name": "Technical SEO Audit",
          "description": "Focused technical audit covering crawlability, indexation, Core Web Vitals, and site architecture.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "500", "priceCurrency": "GBP" }
        },
        {
          "@type": "Offer",
          "name": "AI Search Audit",
          "description": "Audit of your visibility in AI-powered search engines including ChatGPT, Perplexity, and Google AI Overviews.",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "400", "priceCurrency": "GBP" }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is SEO more expensive in Guildford?",
        "acceptedAnswer": { "@type": "Answer", "text": "Not necessarily. My plans sit inside the range the 2026 UK price guides give for small businesses, about £500 to £3,000 a month. Competitive sectors such as property, legal and healthcare need more work. That is why I offer more than one plan." }
      },
      {
        "@type": "Question",
        "name": "What is the minimum contract length?",
        "acceptedAnswer": { "@type": "Answer", "text": "The minimum commitment is three months. SEO results take time to compound, and anything shorter does not give Google enough crawl cycles to reflect changes meaningfully. All plans roll month-to-month after the initial three-month term. Cancelling needs 30 days written notice." }
      },
      {
        "@type": "Question",
        "name": "Can I upgrade or downgrade mid-contract?",
        "acceptedAnswer": { "@type": "Answer", "text": "You can upgrade at any point, with the new rate from the next billing cycle. Downgrades take effect after the current commitment period." }
      },
      {
        "@type": "Question",
        "name": "What results can I expect in the first three months?",
        "acceptedAnswer": { "@type": "Answer", "text": "In the first three months you get the technical fixes, a documented plan and the first on-page changes. Traffic changes depend on how fast Google recrawls and how competitive the terms are. I report monthly from month one." }
      },
      {
        "@type": "Question",
        "name": "Do you offer one-off projects instead of monthly retainers?",
        "acceptedAnswer": { "@type": "Answer", "text": "I do. One-off audits start at £400 (AI Search Audit). Comprehensive SEO audits are £750 and technical audits are £500. Standalone projects like site migrations, schema implementation, or content strategy documents are scoped and quoted individually. Get in touch about your requirements." }
      },
      {
        "@type": "Question",
        "name": "Is there a setup fee?",
        "acceptedAnswer": { "@type": "Answer", "text": "There is not. All onboarding work including the initial technical audit, keyword research, strategy document, and analytics setup is included in the first month of any retainer plan. You pay the monthly rate from day one with no additional setup charges." }
      },
      {
        "@type": "Question",
        "name": "What factors influence SEO pricing?",
        "acceptedAnswer": { "@type": "Answer", "text": "Website size, competitiveness of the target market, scope of work and the experience level of the provider mainly drive SEO pricing. A larger site with thousands of pages typically requires a higher budget than a small single-location business with modest competition. A highly competitive sector such as property or professional services in Guildford does the same." }
      },
      {
        "@type": "Question",
        "name": "Is SEO cheaper than paid advertising in the long run?",
        "acceptedAnswer": { "@type": "Answer", "text": "SEO typically has a higher upfront cost and longer time to results than paid advertising. Once established, ranking positions continue driving traffic without ongoing per-click cost. Paid advertising traffic stops the moment spend stops. Most businesses use SEO and paid search together. Paid campaigns provide immediate traffic while SEO builds toward a lower long-term cost per lead." }
      }
    ]
  }
];

const tiers = [
  {
    name: "Starter",
    price: "£500",
    period: "/mo",
    description: "For local businesses starting to build their search presence in Guildford.",
    features: [
      "Technical SEO audit and fixes",
      "Monthly performance reporting",
      "1-2 keyword clusters targeted",
      "Local SEO fundamentals",
      "Google Business Profile optimisation",
      "Basic on-page optimisation",
      "Quarterly strategy review"
    ],
    cta: "Start with an audit",
    highlight: false
  },
  {
    name: "Growth",
    price: "£1,000",
    period: "/mo",
    description: "For established businesses that want to lead their sector across Surrey.",
    features: [
      "Everything in Starter",
      "Content strategy and creation",
      "3-5 keyword clusters targeted",
      "Link building and digital PR",
      "Competitor monitoring",
      "Monthly strategy calls",
      "Google Analytics and conversion setup"
    ],
    cta: "Choose Growth",
    highlight: true
  },
  {
    name: "Premium",
    price: "£2,000",
    period: "/mo",
    description: "For competitive sectors where search visibility directly drives revenue.",
    features: [
      "Everything in Growth",
      "AI search optimisation (AEO/GEO)",
      "Advanced competitor intelligence",
      "Conversion rate optimisation",
      "Schema and structured data strategy",
      "Bi-weekly strategy calls",
      "Priority support and response"
    ],
    cta: "Go Premium",
    highlight: false
  },
  {
    name: "Enterprise",
    price: "£3,500+",
    period: "/mo",
    description: "For multi-location businesses and complex technical environments.",
    features: [
      "Everything in Premium",
      "Multi-location SEO management",
      "Custom reporting dashboards",
      "Site migration support",
      "Weekly strategy calls",
      "International SEO if required"
    ],
    cta: "Get in touch",
    highlight: false
  }
];

const oneOffs = [
  { name: "Comprehensive SEO Audit", price: "£750", description: "Complete technical and strategic audit with prioritised 90-day action plan, competitor benchmarking, and content gap analysis." },
  { name: "Technical SEO Audit", price: "£500", description: "Focused crawl analysis covering indexation, Core Web Vitals, site architecture, internal linking, and structured data." },
  { name: "AI Search Audit", price: "£400", description: "Visibility assessment across ChatGPT, Perplexity, Google AI Overviews, and Copilot. Includes citation analysis and optimisation roadmap." }
];
---
<Base
  title="SEO Pricing Guildford: Plans from £500/mo"
  description="Transparent SEO pricing for Guildford and Surrey businesses. Monthly plans from £500, one-off audits, no setup fees, and no hidden costs."
  canonical="https://seo-guildford.uk/pricing/"
  schema={schema}
>
  <PageHero
    eyebrow="Pricing &middot; serving Guildford and Surrey"
    crumbs={[{"label": "Services", "href": "/services/"}, {"label": "Pricing"}]}
    lead="Monthly SEO plans start at £500 and audits at £400. Each plan lists what you get. You can start with a free audit."
    cta={{"href": "/free-seo-audit/", "label": "Book my free audit"}}
    glance={{"heading": "At a glance", "points": ["Monthly plans run from £500 (Starter) to £3,500 or more (Enterprise).", "One-off audits start at £400, with technical audits at £500 and comprehensive audits at £750.", "Monthly plans have a three-month initial term and then roll month to month with 30 days' notice.", "A free audit is available first. You can see where you stand before choosing a plan."], "facts": [{"k": "Starter", "v": "£500 a month"}, {"k": "Growth", "v": "£1,000 a month"}, {"k": "Premium", "v": "£2,000 a month"}, {"k": "Enterprise", "v": "From £3,500 a month"}, {"k": "VAT", "v": "Not VAT-registered. No VAT is added."}]}}
    proof={[{"v": "UK price guide", "l": "How my prices compare with eight published 2026 guides.", "href": "/seo-cost-uk/"}, {"v": "Free first audit", "l": "see where you stand before choosing a plan.", "href": "/free-seo-audit/"}]}
  >
    <Fragment slot="title">SEO <span class="mark">Pricing</span> for Guildford and Surrey Businesses</Fragment>
  </PageHero>

  <article class="doc">
  <div class="prose">

      <div class="reveal">
      <h2>My SEO prices for Guildford and Surrey businesses</h2>

      <p>Every price is on this page. Monthly plans start at £500 and one-off audits at £400. I am not VAT-registered. Nothing is added.</p>

      <p>For how these compare with the market: most of the 2026 UK price guides I read put small-business SEO at roughly £500 to £3,000 a month. Whito read 45 published UK monthly prices in June 2026 and found a median of £799. Sources are in my <a href="/seo-cost-uk/">UK SEO cost guide</a>.</p>

      <p>Every plan is priced up front: no hidden fees, and each plan lists what you receive.</p>
      </div>
    </div>

    <!-- Pricing tiers -->
    <div class="reveal">
    <h2 class="text-2xl font-bold text-brand mt-10 mb-6">Monthly retainer plans</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6 my-8">
      {tiers.map((tier, i) => (
        <div class={`service-card flex flex-col reveal ${tier.highlight ? 'border border-accent' : ''}`} style={`--reveal-delay: ${0.1 + i * 0.1}s`}>
          {tier.highlight && (
            <p class="eyebrow mb-3">Recommended for most</p>
          )}
          <div class="mb-4">
            <h3 class="text-xl font-bold text-brand mb-1">{tier.name}</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-3xl font-bold text-text font-mono">{tier.price}</span>
              <span class="text-text-muted text-sm">{tier.period}</span>
            </div>
            <p class="text-text-muted text-sm mt-2">{tier.description}</p>
          </div>
          <ul class="list-none space-y-2 mb-6 flex-1">
            {tier.features.map(f => (
              <li class="flex items-start gap-2 text-sm">
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href="/free-seo-audit/" class={tier.highlight ? 'cta-button text-center w-full' : 'cta-button-outline text-center w-full'}>{tier.cta}</a>
        </div>
      ))}
    </div>

    <div class="prose">
      <h2>One-off services</h2>

      <p>Not every business requires an ongoing retainer. These standalone services are scoped, quoted, and delivered as one-off projects, each with a clear deliverable and defined timeline. See the full <a href="/seo-audit/">SEO audit service</a> page for what a comprehensive audit covers in detail.</p>

      <div class="overflow-x-auto not-prose my-6" tabindex="0" role="region" aria-label="One-off audit prices"><table class="w-full text-sm border border-border"><thead><tr><th scope="col" class="text-left p-3 border-b-2 border-border font-mono uppercase tracking-wide text-xs font-medium">One-off audit</th><th scope="col" class="text-left p-3 border-b-2 border-border font-mono uppercase tracking-wide text-xs font-medium">Price</th></tr></thead><tbody><tr><td class="p-3 border-b border-border align-top">AI search audit</td><td class="p-3 border-b border-border align-top">£400</td></tr><tr><td class="p-3 border-b border-border align-top">Technical audit</td><td class="p-3 border-b border-border align-top">£500</td></tr><tr><td class="p-3 border-b border-border align-top">Comprehensive audit</td><td class="p-3 border-b border-border align-top">£750</td></tr></tbody></table></div>
    </div>

    <div class="grid md:grid-cols-3 gap-5 my-8">
      {oneOffs.map((service, i) => (
        <div class="service-card reveal" style={`--reveal-delay: ${0.1 + i * 0.08}s`}>
          <h3 class="text-lg font-bold text-brand mb-1">{service.name}</h3>
          <p class="text-2xl font-bold text-text font-mono mb-3">{service.price}</p>
          <p class="text-text-muted text-sm">{service.description}</p>
        </div>
      ))}
    </div>

    <div class="prose">
      <div class="reveal">
      <h2>Work out the return with your own numbers</h2>

      <p>Put your deal value, visitors and conversion rate into my <a href="/tools/seo-roi-calculator/">SEO ROI calculator</a>. See <a href="/cost-per-click-guildford/">Google Ads cost per click in Guildford</a> for what a click costs in your sector and so what a free ranking is worth.</p>
      </div>

      <div class="reveal">
      <h2>How my prices compare with the UK market</h2>

      <p>UK price guides published in 2026 put small-business SEO at about £500 to £3,000 a month. The median across 45 published prices is £799 (see my <a href="/seo-cost-uk/">UK SEO cost guide</a> for the sources). My plans sit inside that range and start at £500. Search results around Guildford are competitive in several sectors. Where there is extra cost, it comes from the work needed to compete.</p>

      <p>A Guildford business that needs more than the Starter plan is paying for the work involved. That means more pages, more competitors already investing, or a sector such as property, legal or healthcare where the search results are crowded. The <a href="/cost-per-click-guildford/">click prices advertisers pay in Guildford</a> show which sectors those are.</p>
      </div>

      <div class="reveal">
      <h2>What every plan includes</h2>

      <p>Regardless of which tier you select, every monthly plan includes these baseline deliverables:</p>

      <ul>
        <li><strong>Initial technical audit</strong>: a complete crawl and analysis of your site's technical health, delivered within the first month</li>
        <li><strong>Monthly reporting</strong>: clear, jargon-free reports showing ranking changes, traffic growth, and conversion data</li>
        <li><strong>Google Analytics and Search Console setup</strong>: if not already configured, I establish and verify both during onboarding</li>
        <li><strong>On-page optimisation</strong>: title tags, meta descriptions, heading structure, and content improvements across targeted pages</li>
        <li><strong>Local SEO fundamentals</strong>: Google Business Profile management, local citation audit, and NAP consistency checks</li>
        <li><strong>Direct access to me</strong>: no account managers and no ticket system. You email me.</li>
        <li><strong>No setup fees</strong>: all onboarding work is included in the first month's retainer</li>
      </ul>
      </div>

      <div class="reveal">
      <h2>How to choose the right plan</h2>

      <p>The appropriate plan depends on your competitive environment, your current search visibility, and your revenue objectives. Here is a framework:</p>

      <h3>Choose Starter if</h3>

      <p>You are a small local business with a single location. You have limited current search visibility and a modest budget. You wish to establish the fundamentals: technical health, local listings and a small number of keyword targets. Suits independent retailers on Guildford High Street, sole-practitioner consultancies, and local tradespeople serving the GU postcode.</p>

      <h3>Choose Growth if</h3>

      <p>You have an established business and recognise that SEO is a growth channel rather than merely a maintenance task. You are prepared to invest in content creation, target multiple keyword clusters, and build authority through considered link acquisition. Suits professional services firms, growing hospitality businesses, and mid-size retailers with regional ambitions.</p>

      <h3>Choose Premium if</h3>

      <p>You operate in a competitive sector where search visibility directly correlates with revenue. You wish to be visible in both traditional search and AI-powered search engines. You need conversion rate optimisation alongside traffic growth. Suits property agencies, legal firms, technology companies near Surrey Research Park, and private healthcare providers.</p>

      <h3>Choose Enterprise if</h3>

      <p>You manage multiple locations. You have complex technical requirements (large e-commerce catalogues, custom CMS platforms, international considerations) or need deeper support across several teams. Suits multi-branch businesses across Surrey and Hampshire, franchise operations, and large employers near the University of Surrey.</p>

      <div class="overflow-x-auto not-prose my-6" tabindex="0" role="region" aria-label="Which plan fits"><table class="w-full text-sm border border-border"><thead><tr><th scope="col" class="text-left p-3 border-b-2 border-border font-mono uppercase tracking-wide text-xs font-medium">Plan</th><th scope="col" class="text-left p-3 border-b-2 border-border font-mono uppercase tracking-wide text-xs font-medium">Price a month</th><th scope="col" class="text-left p-3 border-b-2 border-border font-mono uppercase tracking-wide text-xs font-medium">Choose it if</th></tr></thead><tbody><tr><td class="p-3 border-b border-border align-top">Starter</td><td class="p-3 border-b border-border align-top">£500</td><td class="p-3 border-b border-border align-top">You are a small local business with a single location and a modest budget</td></tr><tr><td class="p-3 border-b border-border align-top">Growth</td><td class="p-3 border-b border-border align-top">£1,000</td><td class="p-3 border-b border-border align-top">You are established and ready to invest in content and authority</td></tr><tr><td class="p-3 border-b border-border align-top">Premium</td><td class="p-3 border-b border-border align-top">£2,000</td><td class="p-3 border-b border-border align-top">You work in a competitive sector and want to be visible in AI search too</td></tr><tr><td class="p-3 border-b border-border align-top">Enterprise</td><td class="p-3 border-b border-border align-top">From £3,500</td><td class="p-3 border-b border-border align-top">You manage multiple locations or have complex technical needs</td></tr></tbody></table></div>
      </div>

      <div class="reveal">
      <h2>Frequently asked questions</h2>
      </div>

      <details class="faq-item">
        <summary>Is SEO more expensive in Guildford?</summary>
        <div class="faq-answer">
          <p>Not necessarily. My plans sit inside the range the 2026 UK price guides give for small businesses, about £500 to £3,000 a month. Competitive sectors such as property, legal and healthcare need more work. That is why I offer more than one plan.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>What is the minimum contract length?</summary>
        <div class="faq-answer">
          <p>The minimum commitment is three months. SEO results take time to compound, and anything shorter does not give Google enough crawl cycles to reflect changes meaningfully. All plans roll month-to-month after the initial three-month term. Cancelling needs 30 days written notice.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Can I upgrade or downgrade mid-contract?</summary>
        <div class="faq-answer">
          <p>You can upgrade at any point, with the new rate from the next billing cycle. Downgrades take effect after the current commitment period.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>What results can I expect in the first three months?</summary>
        <div class="faq-answer">
          <p>In the first three months you get the technical fixes, a documented plan and the first on-page changes. Traffic changes depend on how fast Google recrawls and how competitive the terms are. I report monthly from month one.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Do you offer one-off projects instead of monthly retainers?</summary>
        <div class="faq-answer">
          <p>I do. One-off audits start at £400 (AI Search Audit). Comprehensive SEO audits are £750 and technical audits are £500. Standalone projects like site migrations, schema implementation, or content strategy documents are scoped and quoted individually. <a href="/contact/">Get in touch</a> about your requirements.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Is there a setup fee?</summary>
        <div class="faq-answer">
          <p>There is not. All onboarding work including the initial technical audit, keyword research, strategy document, and analytics setup is included in the first month of any retainer plan. You pay the monthly rate from day one with no additional setup charges.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>What factors influence SEO pricing?</summary>
        <div class="faq-answer">
          <p>Website size, competitiveness of the target market, scope of work and the experience level of the provider mainly drive SEO pricing. A larger site with thousands of pages typically requires a higher budget than a small single-location business with modest competition. A highly competitive sector such as property or professional services in Guildford does the same.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Is SEO cheaper than paid advertising in the long run?</summary>
        <div class="faq-answer">
          <p>SEO typically has a higher upfront cost and longer time to results than paid advertising. Once established, ranking positions continue driving traffic without ongoing per-click cost. Paid advertising traffic stops the moment spend stops. Most businesses use SEO and paid search together. Paid campaigns provide immediate traffic while SEO builds toward a lower long-term cost per lead.</p>
        </div>
      </details>

      <div class="reveal">
      <h2>Begin with a free audit</h2>

      <p>Begin with a <a href="/free-seo-audit/">free SEO audit</a> if you are not yet certain which plan fits. It provides a factual baseline of your current search visibility and highlights the most significant opportunities. That is the analytical starting point for every good strategy. From there, I recommend the plan that best aligns with your goals and budget.</p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-8 not-prose">
        <a href="/free-seo-audit/" class="cta-button text-center">Start with an audit</a>
        <a href="/contact/" class="cta-button-outline text-center">Get in touch</a>
      </div>

      <p class="mt-8 text-sm text-text-muted">Questions about pricing? Email <a href="mailto:hello@seo-guildford.uk">hello@seo-guildford.uk</a>. View all <a href="/services/">SEO services</a>, review <a href="/case-studies/">measured portfolio results</a>, or return to the <a href="/">homepage</a>.</p>
    </div>

    <ContactForm eyebrow="Pricing" heading="Find the right plan" subject="SEO Guildford: Pricing enquiry" />
  </article>
</Base>
