---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import ChecklistFigure from '../../components/ChecklistFigure.astro';

const title = 'SEO Surrey: Consultant for Guildford, Farnham, Woking';
const description = 'Solo SEO consultant covering Guildford, Farnham, Woking, Godalming and Camberley across Surrey. Remote-first, with area-specific search work.';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Areas", "item": "https://seo-guildford.uk/areas/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": "https://seo-guildford.uk/areas/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk/" },
    "about": {
      "@type": "Place",
      "name": "Guildford",
      "address": { "@type": "PostalAddress", "addressLocality": "Guildford", "addressRegion": "Surrey", "addressCountry": "GB" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Do you only work with businesses based in Guildford?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. I work with businesses across Surrey, Hampshire, and nationally. However, my deepest local knowledge covers Guildford and surrounding areas within a 20-mile radius, including Woking, Godalming, Farnham, Camberley, and Aldershot." }
      },
      {
        "@type": "Question",
        "name": "How does local SEO differ between Guildford suburbs?",
        "acceptedAnswer": { "@type": "Answer", "text": "Each suburb has distinct search patterns. Burpham residents search differently from Onslow Village residents due to demographics, proximity to the University of Surrey, and local amenities. A locksmith in Merrow faces different competition than one in Stoughton. I tailor keyword targeting, Google Business Profile categories, and content to match each area's search behaviour." }
      },
      {
        "@type": "Question",
        "name": "Can you help businesses that serve multiple areas across Surrey?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. I build location pages, manage one Google Business Profile per branch, and plan content so each area has its own page without duplicate content." }
      },
      {
        "@type": "Question",
        "name": "What is the typical search volume for Guildford-specific queries?",
        "acceptedAnswer": { "@type": "Answer", "text": "Small. \"seo guildford\" is about 50 searches a month and most \"[service] guildford\" terms are between 10 and a few hundred (Google Ads data, UK, pulled 7 November 2026). The value is intent. Advertisers pay several pounds a click for many of them. You can see that on my cost per click page." }
      },
      {
        "@type": "Question",
        "name": "How long does local SEO take to show results in the Guildford area?",
        "acceptedAnswer": { "@type": "Answer", "text": "Google has to recrawl the changed pages before anything moves. Map pack changes often show before organic rankings. Competitive sectors such as property, legal and healthcare take longer. I report monthly from month one." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between local SEO and general SEO?",
        "acceptedAnswer": { "@type": "Answer", "text": "Local SEO targets searches with geographic intent, such as \"plumber Guildford\" or \"dentist near me\", and relies on Google Business Profile, local citations, and location-specific content. General SEO targets broader search terms without geographic filtering and focuses on domain authority and topical coverage nationally. Most Guildford businesses serving local customers need local SEO as the primary focus, with general SEO layered in where services also attract enquiries from outside the area." }
      },
      {
        "@type": "Question",
        "name": "Do I need a separate landing page for every area I serve?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, if you genuinely serve multiple distinct areas with different customer bases. A dedicated page for each area, built with real local detail rather than a templated page with the town name swapped in, helps Google match your business to area-specific searches. It also avoids the duplicate content issues that generic multi-location pages create." }
      }
    ]
  }
];
---

<Base title={title} description={description} schema={schema}>
<PageHero
    eyebrow="Areas I cover"
    crumbs={[{"label": "Areas"}]}
    lead="I provide local SEO for Guildford town centre and every major suburb. I also cover the wider Surrey commuter belt and Hampshire border towns including Aldershot and Farnham."
    glance={{"heading": "At a glance", "points": ["Guildford town centre and the main suburbs.", "The wider Surrey commuter belt.", "Hampshire border towns including Aldershot and Farnham.", "Each area gets its own local search research, not a template with the town name swapped."], "facts": [{"k": "Service area", "v": "Guildford, Surrey and Hampshire"}, {"k": "Who does the work", "v": "Me, directly"}, {"k": "Free audit report", "v": "2 to 3 working days, PDF by email"}]}}
    tools={false}
    photo={{"src": "/images/guildford-high-street.jpg", "alt": "Timber-framed buildings on Guildford High Street", "credit": "Photo: 46 High Street, Guildford by Tim Sheerman-Chase, CC BY 2.0, via Wikimedia Commons.", "creditHref": "https://commons.wikimedia.org/wiki/File:46_High_Street,_Guildford_(side).jpg"}}
  >
    <Fragment slot="title">SEO consultant for <span class="mark">Surrey</span>: Guildford, Woking, Farnham, Godalming and Camberley</Fragment>
  </PageHero>

  <article class="doc">

    <p class="reveal text-text-muted mb-4">Areas covered on this page:</p>
    <div class="not-prose flex flex-wrap gap-2 mb-8 reveal">
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Guildford</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Onslow Village</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Merrow</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Burpham</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Stoughton</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Park Barn</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Bellfields</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Westborough</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Pewley Hill</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Charlotteville</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Shalford</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Woking</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Godalming</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Cranleigh</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Farnham</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Camberley</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Cobham</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Esher</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Weybridge</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Aldershot</span>
      <span class="border border-border rounded px-3 py-1 text-sm text-text-muted">Alton</span>
    </div>

    <div class="prose">

      <div class="reveal">
      <h2>Guildford town centre</h2>

      <p>Guildford's town centre has the highest commercial search volume in the borough. The High Street mixes independent retailers, professional firms and hospitality, all competing in organic results and the local map pack.</p>

      <p>The <strong>Friary Centre</strong> anchors retail search demand. National chains and local shops draw footfall from across Surrey, and businesses here compete on branded and category terms. Google Business Profile work is essential for "near me" searches from shoppers already in the centre.</p>

      <p>The <strong>Tunsgate Quarter</strong> attracts a more affluent shopper and independent retailers. SEO there leans to lifestyle and premium service queries.</p>

      <p>The <strong>Cathedral business district</strong> surrounding Guildford Cathedral is home to legal firms, accountancy practices, and financial advisers. These businesses require authority-driven SEO strategies built on thought leadership content, professional directory citations, and schema markup for professional services. Competition here is particularly fierce; the Cathedral area concentrates some of Surrey's most established firms, and dislodging them from the top positions demands patience and precision in equal measure.</p>

      <ChecklistFigure title="Town centre areas I work in" items={["The High Street", "Friary Centre", "Tunsgate Quarter", "Cathedral business district"]} caption="Each area has its own search demand and competition." />
      </div>

      <div class="reveal">
      <h2>Guildford suburbs</h2>

      <p>Each Guildford suburb has a distinct demographic profile that shapes local search behaviour in ways both obvious and surprisingly granular.</p>

      <h3>Onslow Village and the university corridor</h3>

      <p><strong>Onslow Village</strong> sits adjacent to the University of Surrey campus. This creates a dual search audience that shifts with the academic calendar. Long-term residents sit on one side and a rotating student population on the other. Businesses here benefit from term-time seasonal content and student-oriented service pages. The proximity to <strong>Surrey Research Park</strong> adds B2B search demand from tech companies and startups.</p>

      <h3>Merrow and Burpham</h3>

      <p><strong>Merrow</strong> is a residential suburb on the eastern edge of Guildford with a village-centre feel. Its smaller competitive pool means that consistent Google Business Profile management and locally-relevant content can establish genuine dominance relatively quickly. <strong>Burpham</strong>, slightly further north, has seen significant development, and its search landscape is evolving in real time as new residents cultivate local search habits. Both areas feed into the A3 corridor. The A3 corridor shapes commuter-related search patterns across the borough.</p>

      <h3>Stoughton, Park Barn and Bellfields</h3>

      <p><strong>Stoughton</strong> borders the Royal Surrey County Hospital, and that proximity generates a rich seam of healthcare-adjacent search demand. <strong>Park Barn</strong> and <strong>Bellfields</strong> are residential areas where local tradespeople and home services dominate the query landscape. These suburbs carry lower average property values than Merrow or Pewley Hill. That economic reality shapes both the types of services people search for and the price sensitivity embedded in their queries.</p>

      <h3>Westborough, Pewley Hill and Charlotteville</h3>

      <p><strong>Westborough</strong> connects the town centre to the western suburbs and has cultivated a growing independent business scene. <strong>Pewley Hill</strong> and <strong>Charlotteville</strong> sit among Guildford's most affluent areas, with high property values. SEO for businesses serving these postcodes should target premium service queries and carry quality signals throughout. The audience here evaluates credibility before it evaluates price.</p>

      <h3>Shalford and southern villages</h3>

      <p><strong>Shalford</strong>, just south of the town centre, retains a distinct village identity that colours the way its residents search. They type "Shalford" rather than "Guildford", making hyper-local keyword targeting not just useful but essential. The same pattern holds for <strong>Compton</strong>, <strong>Bramley</strong>, <strong>Wonersh</strong>, and <strong>Chilworth</strong>, each village a self-contained micro-search ecosystem with its own rhythms and vocabulary.</p>

      <ChecklistFigure title="Guildford suburbs and villages" items={["Onslow Village", "Merrow and Burpham", "Stoughton, Park Barn and Bellfields", "Westborough, Pewley Hill and Charlotteville", "Shalford and southern villages"]} caption="Each suburb has a distinct demographic profile." />
      </div>

      <div class="reveal">
      <h2>Wider Surrey</h2>

      <p>Beyond Guildford borough, my SEO services extend across the Surrey commuter belt. Each town presents different competitive dynamics and distinct search cultures. These reward a measured, area-specific approach over any kind of templated uniformity.</p>

      <h3>Woking</h3>

      <p><strong>Woking</strong> is Surrey's second-largest commercial centre. It sustains its own fully developed competitive search landscape. Businesses serving both Guildford and Woking need careful geo-targeting to avoid cannibalising their own rankings across the two towns. This is a common pitfall when only 8 miles separate your service areas. Google must decide which page deserves which query.</p>

      <h3>Godalming and Cranleigh</h3>

      <p><strong>Godalming</strong>, four miles south, is a market town whose High Street businesses compete mainly with each other. <strong>Cranleigh</strong>, further south, has a rural and affluent identity and its businesses do better with content that reflects it than with borrowed Guildford terms.</p>

      <h3>Farnham, Camberley, and western Surrey</h3>

      <p><strong>Farnham</strong> straddles the Surrey-Hampshire border, creating dual-county search opportunities that most agencies overlook entirely. <strong>Camberley</strong> serves the M3 corridor and carries a different commercial profile, with more military-adjacent and logistics businesses shaping the query mix. <strong>Cobham</strong>, <strong>Esher</strong>, and <strong>Weybridge</strong> in the north-east of the county rank among the wealthiest towns in the UK. SEO strategies here must mirror the premium positioning that their local consumers instinctively expect. Anything that feels mass-market will be scrolled past.</p>

      <ChecklistFigure title="Wider Surrey towns I cover" items={["Woking", "Godalming and Cranleigh", "Farnham", "Camberley", "Cobham, Esher and Weybridge"]} caption="Each town has different competitive dynamics." />
      </div>

      <div class="reveal">
      <h2>Hampshire border</h2>

      <p>The Hampshire border towns of <strong>Aldershot</strong>, <strong>Farnham</strong>, and <strong>Alton</strong> fall within my coverage area, and each one has its own search patterns. Aldershot has undergone significant regeneration, and new businesses there are building their online presence. Farnham surfaces in both Surrey and Hampshire search results depending on the query. This gives businesses an opening if they optimise for both counties.</p>

      <p>Alton is further afield. It shares meaningful search overlap with Guildford for service-area businesses in trades, healthcare, and professional services. Businesses based in Guildford that serve the Hampshire border need dedicated location pages built on genuine local content. Without that specificity, Google has no reason to show your site to a searcher in Alton when a local competitor is standing right there.</p>
      </div>

      <div class="reveal">
      <h2>Business hubs</h2>

      <p>Guildford has two business hubs with different SEO needs.</p>

      <dl class="def-grid not-prose">
  <div><dt>Surrey Research Park</dt><dd>Predominantly B2B: tech, AI, satellite engineering, and biotech, needing thought leadership and technical documentation SEO.</dd></div>
  <div><dt>Slyfield Industrial Estate</dt><dd>Guildford's largest industrial zone: trade suppliers, logistics, and light manufacturing, driven by commercial intent and Google Business Profile.</dd></div>
</dl>

      <h3>Surrey Research Park</h3>

      <p><strong>Surrey Research Park</strong>, owned by the University of Surrey, houses tech firms, AI companies, satellite engineering outfits and biotech startups. SEO for Research Park businesses is predominantly B2B. The audience consists of technical decision-makers, not local consumers. The content strategies that work here focus on thought leadership, technical documentation ranking, and LinkedIn-integrated search visibility. It is a different discipline from High Street SEO. It deserves to be treated as such. See the full range of <a href="/services/">SEO services</a> I offer for both disciplines.</p>

      <h3>Slyfield Industrial Estate</h3>

      <p><strong>Slyfield Industrial Estate</strong> is Guildford's largest industrial zone, home to trade suppliers, logistics companies, and light manufacturing. SEO for Slyfield businesses focuses on commercial intent queries, product searches, and trade-specific terms. Google Business Profile optimisation is critical here because many customers navigate via maps rather than organic search. The underlying <a href="/technical-seo-guildford/">technical SEO</a> foundations of crawlability, site speed and clean structure still determine whether that visibility converts into traffic.</p>
      </div>

      <div class="reveal">
      <h2>Why local knowledge matters for SEO</h2>

      <p>I do not guess which towns matter. Google Ads data shows how many people search "seo" with each town name, and Search Console shows which town names actually bring your pages impressions. I build area pages only where that demand exists, and each one is written from real local detail rather than a template with the town name swapped.</p>

      <div class="not-prose overflow-x-auto my-6">
        <table class="w-full text-sm border border-border bg-glass">
          <caption class="text-left text-sm text-text-muted p-2">Google Ads monthly search volume, UK, via DataForSEO, pulled 7 November 2026. Small numbers: the value is intent, not volume.</caption>
          <thead><tr class="bg-surface text-left"><th class="p-2">Search</th><th class="p-2">Monthly searches (UK)</th></tr></thead>
          <tbody>
            <tr class="border-t border-border"><td class="p-2">seo surrey</td><td class="p-2">140</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo agency surrey</td><td class="p-2">140</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo farnham</td><td class="p-2">70</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo camberley</td><td class="p-2">50</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo guildford</td><td class="p-2">50</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo agency guildford</td><td class="p-2">50</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo consultant guildford</td><td class="p-2">10</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo woking</td><td class="p-2">10</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo godalming</td><td class="p-2">10</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo cobham</td><td class="p-2">10</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo esher</td><td class="p-2">10</td></tr>
            <tr class="border-t border-border"><td class="p-2">seo weybridge</td><td class="p-2">10</td></tr>
          </tbody>
        </table>
      </div>

      <p>Every area page I build carries genuine local references, not templated copy with only the town name swapped. Google's spam policies cover doorway pages and pages that differ only by location. My local pages are written from real area knowledge.</p>

      <p>If you want to see how your own area's search landscape looks right now, start with a <a href="/free-seo-audit/">free SEO audit</a> before committing to anything further.</p>
      </div>

      <div class="reveal">
      <h2>Frequently asked questions</h2>

      <div class="faq-item">
        <details>
          <summary>Do you only work with businesses based in Guildford?</summary>
          <p>No. I work with businesses across Surrey, Hampshire, and nationally. However, my deepest local knowledge covers Guildford and surrounding areas within a 20-mile radius, including Woking, Godalming, Farnham, Camberley, and Aldershot.</p>
        </details>
      </div>

      <div class="faq-item">
        <details>
          <summary>How does local SEO differ between Guildford suburbs?</summary>
          <p>Each suburb has distinct search patterns. Burpham residents search differently from Onslow Village residents due to demographics, proximity to the University of Surrey, and local amenities. A locksmith in Merrow faces different competition than one in Stoughton. I tailor keyword targeting, Google Business Profile categories, and content to match each area's search behaviour.</p>
        </details>
      </div>

      <div class="faq-item">
        <details>
          <summary>Can you help businesses that serve multiple areas across Surrey?</summary>
          <p>Yes. I build location pages, manage one Google Business Profile per branch, and plan content so each area has its own page without duplicate content.</p>
        </details>
      </div>

      <div class="faq-item">
        <details>
          <summary>What is the typical search volume for Guildford-specific queries?</summary>
          <p>Small. "seo guildford" is about 50 searches a month and most "[service] guildford" terms are between 10 and a few hundred (Google Ads data, UK, pulled 7 November 2026). The value is intent. Advertisers pay several pounds a click for many of them. You can see that on my <a href="/cost-per-click-guildford/">cost per click page</a>.</p>
        </details>
      </div>

      <div class="faq-item">
        <details>
          <summary>How long does local SEO take to show results in the Guildford area?</summary>
          <p>Google has to recrawl the changed pages before anything moves. Map pack changes often show before organic rankings. Competitive sectors such as property, legal and healthcare take longer. I report monthly from month one.</p>
        </details>
      </div>

      <div class="faq-item">
        <details>
          <summary>What is the difference between local SEO and general SEO?</summary>
          <p>Local SEO targets searches with geographic intent, such as "plumber Guildford" or "dentist near me", and relies on Google Business Profile, local citations, and location-specific content. General SEO targets broader search terms without geographic filtering and focuses on domain authority and topical coverage nationally. Most Guildford businesses serving local customers need local SEO as the primary focus, with general SEO layered in where services also attract enquiries from outside the area.</p>
        </details>
      </div>

      <div class="faq-item">
        <details>
          <summary>Do I need a separate landing page for every area I serve?</summary>
          <p>Yes, if you genuinely serve multiple distinct areas with different customer bases. A dedicated page for each area, built with real local detail rather than a templated page with the town name swapped in, helps Google match your business to area-specific searches. It also avoids the duplicate content issues that generic multi-location pages create.</p>
        </details>
      </div>
      </div>

    </div>

    <div class="mt-12 bg-surface-alt border border-border rounded-[0.35rem] p-8 reveal">
      <p class="eyebrow mb-3">Get Started</p>
      <h2 class="text-2xl font-bold text-brand mb-3">See where you stand in local search</h2>
      <p class="text-text-muted mb-6">Your customers may be in Guildford town centre, the Surrey commuter belt, or Hampshire border towns. I will research the searches that matter to your business. I will show you where the opportunities are.</p>
      <a href="/contact/" class="cta-button">Start with an audit</a>
    </div>

    <nav class="mt-10 pt-6 border-t border-border text-sm text-text-muted" aria-label="Related pages">
      <p>Explore more: <a href="/" class="text-brand hover:underline">Home</a> | <a href="/services/" class="text-brand hover:underline">Services</a> | <a href="/industries/" class="text-brand hover:underline">Industries</a></p>
    </nav>

  </article>

  <ContactForm eyebrow="Your area" heading="Talk about your local search" subject="SEO Guildford: Areas enquiry" />
</Base>
