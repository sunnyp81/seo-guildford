---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://seo-guildford.uk/services/" },
      { "@type": "ListItem", "position": 3, "name": "Free SEO Audit", "item": "https://seo-guildford.uk/free-audit/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Free SEO Audit Guildford",
    "description": "Request a free SEO audit for your Guildford business. A short site health check covering technical issues, local visibility and Google Business Profile, by email within two to three working days.",
    "url": "https://seo-guildford.uk/free-audit/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Free SEO Audit",
    "description": "A free SEO health check for Guildford and Surrey businesses covering technical errors, local search visibility, and Google Business Profile status.",
    "provider": {
      "@type": "Organization",
      "name": "SEO Guildford",
      "legalName": "ND Media Ltd",
      "url": "https://seo-guildford.uk/",
      "email": "hello@seo-guildford.uk",
      "sameAs": ["https://find-and-update.company-information.service.gov.uk/company/10784524"],
      "areaServed": { "@type": "City", "name": "Guildford" }
    },
    "areaServed": { "@type": "City", "name": "Guildford", "containedInPlace": { "@type": "AdministrativeArea", "name": "Surrey" } },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "GBP",
      "availability": "https://schema.org/InStock",
      "url": "https://seo-guildford.uk/free-audit/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How long does the free SEO audit take?",
        "acceptedAnswer": { "@type": "Answer", "text": "You receive the report within two to three working days of submitting the form. I review each site by hand, not with an automated tool." }
      },
      {
        "@type": "Question",
        "name": "Is the free audit genuinely without obligation?",
        "acceptedAnswer": { "@type": "Answer", "text": "It is. There is no contract. No payment details are required. You have no obligation to purchase any services. The audit is a genuine site health check you can act on entirely independently. Discussing next steps is wholly your choice." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between the free audit and the comprehensive SEO audit?",
        "acceptedAnswer": { "@type": "Answer", "text": "The free audit covers surface-level technical health, local visibility, and Google Business Profile status. The comprehensive audit (£750) includes deep crawl analysis, backlink profiling, competitor benchmarking, content gap analysis, and a prioritised action plan with estimated ROI." }
      },
      {
        "@type": "Question",
        "name": "Do you audit websites outside Guildford?",
        "acceptedAnswer": { "@type": "Answer", "text": "The free audit is available to any business in Guildford, Woking, Godalming, Farnham, or the wider Surrey area. Businesses outside Surrey should get in touch to discuss availability." }
      }
    ]
  }
];
---
<Base
  title="Free SEO Audit Guildford: Site Health Check"
  description="Request a free SEO audit for your Guildford business. A site health check covering technical issues, local visibility, and search rankings. No obligation."
  canonical="https://seo-guildford.uk/free-audit/"
  schema={schema}
>
  <PageHero
    eyebrow="Free SEO Audit &middot; serving Guildford and Surrey"
    crumbs={[{"label": "Services", "href": "/services/"}, {"label": "Free SEO Audit"}]}
    lead="Send your website address and I will review it by hand. You get a short PDF report by email within two to three working days."
    cta={{"href": "#enquire", "label": "Go to the form"}}
    glance={{"heading": "At a glance", "points": ["Send your website address through the form below.", "You receive a short PDF report by email within two to three working days.", "It covers technical health, local search visibility and your Google Business Profile.", "There is no contract, no payment details and no obligation to buy anything."], "facts": [{"k": "Price", "v": "Free"}, {"k": "Turnaround", "v": "2 to 3 working days"}, {"k": "Format", "v": "PDF by email"}, {"k": "Obligation", "v": "None"}]}}
    proof={[{"v": "1 working day", "l": "to reply to every enquiry. The reply comes from me.", "href": "/contact/"}, {"v": "£750", "l": "for the comprehensive audit if you want the full review.", "href": "/audit/"}]}
  >
    <Fragment slot="title">Free <span class="mark">SEO Audit</span> for Guildford Businesses</Fragment>
  </PageHero>

  <article class="doc">
  <div class="prose">

    </div>

    <!-- Audit request form -->
    <section id="enquire">
      <div id="enquire-done" hidden class="border border-accent bg-surface-alt rounded-md px-5 py-6 mb-6"><p class="font-heading text-xl text-brand m-0">Thank you, your enquiry is in. I reply personally, usually within one working day.</p></div>
      <div id="enquire-form">
        <form action="https://emailit-worker.sunnypat81.workers.dev/" method="POST" class="bg-glass rounded-[0.35rem] border border-border p-6 md:p-8 my-8 space-y-5 reveal">
          <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
          <input type="hidden" name="_site" value="seo-guildford.uk" />
          <input type="hidden" name="subject" value="SEO Guildford: Free Audit Request (seo-guildford.uk)" />
          <input type="hidden" name="redirectTo" value="https://seo-guildford.uk/free-audit/?sent=1&amp;form=free-audit" />
          <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Leave this field blank" />
          <p class="text-sm text-text-muted mb-2">All fields marked with * are required.</p>

          <div>
            <label for="name" class="block text-sm font-medium text-text mb-1">Name *</label>
            <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-2.5 rounded border border-border bg-glass text-text focus:outline-none focus:border-accent transition-colors" placeholder="Your full name" />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text mb-1">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-2.5 rounded border border-border bg-glass text-text focus:outline-none focus:border-accent transition-colors" placeholder="you@example.co.uk" />
          </div>

          <div>
            <label for="website" class="block text-sm font-medium text-text mb-1">Website URL *</label>
            <input type="url" id="website" name="website" required autocomplete="url" class="w-full px-4 py-2.5 rounded border border-border bg-glass text-text focus:outline-none focus:border-accent transition-colors" placeholder="https://www.yourbusiness.co.uk" />
          </div>

          <div>
            <label for="business-type" class="block text-sm font-medium text-text mb-1">Business Type *</label>
            <select id="business-type" name="business_type" required class="w-full px-4 py-2.5 rounded border border-border bg-glass text-text focus:outline-none focus:border-accent transition-colors">
              <option value="" disabled selected>Select your sector</option>
              <option value="gaming-tech">Gaming / Technology</option>
              <option value="professional-services">Professional Services</option>
              <option value="property">Property / Estate Agency</option>
              <option value="healthcare">Healthcare</option>
              <option value="retail">Retail</option>
              <option value="hospitality">Hospitality</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text mb-1">Message (optional)</label>
            <textarea id="message" name="message" rows="3" class="w-full px-4 py-2.5 rounded border border-border bg-glass text-text focus:outline-none focus:border-accent transition-colors resize-y" placeholder="Tell me about your principal SEO goals or concerns"></textarea>
          </div>

          <button type="submit" class="cta-button w-full text-center">Request your audit</button>

          <p class="text-xs text-text-muted text-center">Your data is used solely to deliver the audit. No unsolicited correspondence, no mailing lists.</p>
        </form>
      </div>
    </section>
    <!-- End form -->

    <div class="prose">

      <p>Small problems build up on a site nobody has checked: broken links, missing titles, an unclaimed Google Business Profile, slow pages. Each costs some visibility, and together they hand enquiries to competitors.</p>


      <div class="reveal">
      <h2>What the free audit includes</h2>

      <p>The free audit is a focused review rather than a full-depth analysis, covering the areas that matter most for identifying immediate opportunities:</p>

      <ul>
        <li><strong>Technical health scan</strong>: crawl errors, broken links, page speed issues, and mobile usability problems that directly affect rankings</li>
        <li><strong>Local visibility check</strong>: how your business appears in Google Maps and local pack results for your target area in Guildford and surrounding towns</li>
        <li><strong>Google Business Profile review</strong>: whether your GBP listing is claimed, complete, and properly optimised for local search queries</li>
        <li><strong>On-page SEO snapshot</strong>: title tags, meta descriptions, heading structure, and basic content issues on your most important pages</li>
      </ul>

      <p>You receive a concise PDF report with findings and a clear explanation of what each issue means for your business.</p>
      </div>

    </div>

    <div class="prose">
      <div class="reveal">
      <h2>What happens after you submit</h2>

      <p>Here is precisely what to expect after you submit the form:</p>

      <ol>
        <li><strong>Acknowledgement</strong>: I reply within one working day to confirm your site is in the queue</li>
        <li><strong>Manual review</strong>: I review your website by hand, checking technical health, local visibility, and on-page fundamentals with the thoroughness your business deserves</li>
        <li><strong>Report delivery</strong>: within two to three working days, you receive a concise PDF report to your email with findings and recommended next steps</li>
      </ol>

      <p>The report is written in plain English you can act on yourself or hand to your developer.</p>
      </div>

      <div class="reveal">
      <h2>How the free audit differs from a comprehensive SEO audit</h2>

      <p>The free audit is a surface-level health check that catches the most apparent problems and provides a factual starting point. The <a href="/audit/">comprehensive SEO audit</a> (£750) goes significantly further for businesses that need deeper insight.</p>

      <p>A comprehensive audit includes a complete technical crawl of every page and a backlink profile analysis. It adds detailed competitor benchmarking against three to five rivals and a content gap analysis showing missed keyword opportunities. It ends with a prioritised 90-day action plan with estimated traffic and revenue impact. It also covers AI search readiness. That is increasingly relevant for Guildford businesses competing in sectors like technology, property and professional services.</p>

      <p>The free audit is a first check. The comprehensive audit is the full investigation. Both are valuable and they serve different purposes. Many clients start with the free version and commission the full audit once they see the scale of opportunity that data reveals.</p>

      <p>View the <a href="/pricing/">full pricing breakdown</a> for all audit and retainer options.</p>
      </div>

      <div class="reveal">
      <h2>What a ranking is worth in Guildford</h2>

      <p>Advertisers pay for the same searches you want to rank for. My <a href="/cost-per-click/">Google Ads cost per click data</a> lists the average click price for 78 local services when people in Guildford search. You can see what a free click in your sector is worth before you spend anything.</p>
      </div>

      <div class="reveal">
      <h2>Frequently asked questions</h2>
      </div>

      <details class="faq-item">
        <summary>How long does the free SEO audit take?</summary>
        <div class="faq-answer">
          <p>You receive the report within two to three working days of submitting the form. I review each site by hand, not with an automated tool.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Is the free audit genuinely without obligation?</summary>
        <div class="faq-answer">
          <p>It is. There is no contract. No payment details are required. You have no obligation to purchase any services. The audit is a genuine site health check you can act on entirely independently. Discussing next steps is wholly your choice.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>What is the difference between the free audit and the comprehensive SEO audit?</summary>
        <div class="faq-answer">
          <p>The free audit covers surface-level technical health, local visibility, and Google Business Profile status. The <a href="/audit/">comprehensive audit</a> (£750) includes deep crawl analysis, backlink profiling, competitor benchmarking, content gap analysis, and a prioritised action plan with estimated ROI.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Do you audit websites outside Guildford?</summary>
        <div class="faq-answer">
          <p>The free audit is available to any business in Guildford, Woking, Godalming, Farnham, or the wider Surrey area. Businesses outside Surrey should <a href="/contact/">get in touch</a> to discuss availability.</p>
        </div>
      </details>

      <div class="reveal">
      <h2>Next steps</h2>

      <p>Submit the form above to understand where your website stands. If you already know you need ongoing SEO support, explore the <a href="/pricing/">monthly retainer plans</a> or read about the full range of <a href="/services/">SEO services</a> available.</p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-8 not-prose">
        <a href="/audit/" class="cta-button text-center">Comprehensive SEO Audit (£750)</a>
        <a href="/pricing/" class="cta-button-outline text-center">View Pricing</a>
      </div>

      <p class="mt-8 text-sm text-text-muted">I am a solo SEO consultant serving Guildford and Surrey. Questions? Email <a href="mailto:hello@seo-guildford.uk">hello@seo-guildford.uk</a> or read <a href="/about/">about me</a>.</p>
    </div>
  </article>
</Base>

<script>if(new URLSearchParams(window.location.search).get('sent')==='1'){const f=document.getElementById('enquire-form'),d=document.getElementById('enquire-done');if(f)f.hidden=true;if(d)d.hidden=false;}</script>
