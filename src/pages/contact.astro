---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const title = "Get in Touch: SEO Guildford";
const description = "Contact SEO Guildford to start with an audit of your search performance. Serving Guildford, Surrey, and Hampshire. Email hello@seo-guildford.uk.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seo-guildford.uk/" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://seo-guildford.uk/contact/" }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": "https://seo-guildford.uk/contact/",
  "isPartOf": { "@type": "WebSite", "name": "SEO Guildford", "url": "https://seo-guildford.uk" }
};

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact SEO Guildford",
  "url": "https://seo-guildford.uk/contact/",
  "mainEntity": {
    "@type": "Organization",
    "name": "SEO Guildford",
    "legalName": "ND Media Ltd",
    "identifier": "10784524",
    "url": "https://seo-guildford.uk",
    "email": "hello@seo-guildford.uk",
    "sameAs": ["https://find-and-update.company-information.service.gov.uk/company/10784524"],
    "areaServed": [
      { "@type": "City", "name": "Guildford" },
      { "@type": "AdministrativeArea", "name": "Surrey" },
      { "@type": "AdministrativeArea", "name": "Hampshire" }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you work remotely?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. SEO Guildford operates remote-first. Meetings take place via video call, reporting is shared through live dashboards, and communication is handled via email or your preferred channel. In-person meetings in Guildford, Woking, or elsewhere in Surrey can be arranged when the occasion warrants."
      }
    },
    {
      "@type": "Question",
      "name": "What areas do you cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "My primary service area includes Guildford, Woking, Godalming, Farnham, Camberley and Cobham. I also serve the wider Surrey and Hampshire corridor. Remote delivery means clients anywhere in the UK or internationally receive the same standard of work."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly can we start?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most engagements begin within one week of agreement. The initial technical audit is typically delivered within the first five to seven working days, with strategic recommendations and implementation following immediately after."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer free consultations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. An initial discovery call is always free and carries no obligation. For a more detailed assessment, request a free SEO audit. It provides a technical and strategic overview of your site before any commitment."
      }
    }
  ]
};

const schema = [breadcrumbSchema, webPageSchema, contactPageSchema, faqSchema];
---

<Base title={title} description={description} canonical="https://seo-guildford.uk/contact/" schema={schema}>
<PageHero
    eyebrow="Contact"
    crumbs={[{"label": "Contact"}]}
    lead="Use the form. Tell me about your business and your website. I reply within one working day."
    cta={null}
    tools={false}
  >
    <Fragment slot="title">Get in <span class="mark">touch</span></Fragment>
    <div slot="side">
    <section id="enquire">
      <div id="enquire-done" hidden class="border border-accent bg-surface-alt rounded-md px-5 py-6 mb-6"><p class="font-heading text-xl text-brand m-0">Thank you, your enquiry is in. I reply personally, usually within one working day.</p></div>
      <div id="enquire-form">
        <form action="https://emailit-worker.sunnypat81.workers.dev/" method="POST" class="sheet space-y-5 p-6 md:p-8">
          <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
          <input type="hidden" name="_site" value="seo-guildford.uk" />
          <input type="hidden" name="subject" value="SEO Guildford: New Enquiry (seo-guildford.uk)" />
          <input type="hidden" name="redirectTo" value="https://seo-guildford.uk/contact/?sent=1&amp;form=contact" />
          <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Leave this field blank" />
          <div>
            <label for="name" class="block text-sm font-medium text-text mb-1.5">Name <span class="text-accent">*</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" class="w-full rounded border border-border bg-glass px-4 py-2.5 text-text placeholder:text-text-muted/50 focus:border-accent outline-none transition" placeholder="Your name" />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text mb-1.5">Email <span class="text-accent">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" class="w-full rounded border border-border bg-glass px-4 py-2.5 text-text placeholder:text-text-muted/50 focus:border-accent outline-none transition" placeholder="you@company.co.uk" />
          </div>

          <div>
            <label for="website" class="block text-sm font-medium text-text mb-1.5">Website URL</label>
            <input type="url" id="website" name="website" autocomplete="url" class="w-full rounded border border-border bg-glass px-4 py-2.5 text-text placeholder:text-text-muted/50 focus:border-accent outline-none transition" placeholder="https://yoursite.co.uk" />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text mb-1.5">Message <span class="text-text-muted font-normal">(optional)</span></label>
            <textarea id="message" name="message" rows="5" class="w-full rounded border border-border bg-glass px-4 py-2.5 text-text placeholder:text-text-muted/50 focus:border-accent outline-none transition resize-y" placeholder="Tell me about your business and what you are looking to achieve with search."></textarea>
          </div>

          <button type="submit" class="cta-button w-full sm:w-auto">Send my enquiry</button>
        </form>
      </div>
    </section>
    </div>
  </PageHero>

  <section class="doc">
    <div class="prose">
      <div class="reveal">
      <h2>How I work with enquiries</h2>

      <p>Use the form. Tell me about your business and your website address. I read every enquiry myself and reply within one working day. The first conversation is free and carries no obligation.</p>

      <p>I work remotely with businesses across Guildford, Surrey and Hampshire. Your office can be anywhere in the UK.</p>
      </div>
    </div>



    <div class="prose mt-12 reveal">
      <h2>How I work with you</h2>

      <p>SEO Guildford operates remote-first for businesses across Guildford and Surrey. Meetings take place by video call, with reporting shared through live dashboards. In-person meetings in Guildford or elsewhere in Surrey can be arranged when useful. ND Media Ltd's registered office is in Reading.</p>
    </div>

    <div class="reveal mt-6 grid sm:grid-cols-2 gap-4 not-prose">
      <div class="service-card">
        <p class="eyebrow mb-2">Delivery</p>
        <p class="text-brand font-heading text-lg mb-2">Remote-first</p>
        <p class="text-text-muted text-sm m-0">Video calls, shared reporting, and direct access to the practitioner doing the work.</p>
      </div>
      <div class="service-card">
        <p class="eyebrow mb-2">Service area</p>
        <p class="text-brand font-heading text-lg mb-2">Guildford and Surrey</p>
        <p class="text-text-muted text-sm m-0">Local market focus without claiming a physical Guildford office.</p>
      </div>
    </div>

    <div class="prose mt-12">
      <div class="reveal">
      <h2>Areas we cover</h2>

      <p>SEO Guildford provides search consultancy services across the Surrey and Hampshire corridor, including Guildford, Woking, Godalming, Farnham, Camberley, Cobham, Esher, and Weybridge. The <a href="/areas/">areas page</a> lists local information for each service area.</p>
      </div>

      <div class="reveal">
      <h2>Frequently asked questions</h2>

      <details class="faq-item">
        <summary>Do you work remotely?</summary>
        <p>Yes. SEO Guildford operates remote-first. Meetings take place via video call, reporting is shared through live dashboards, and communication is handled via email or your preferred channel. In-person meetings in Guildford, Woking, or elsewhere in Surrey can be arranged when the occasion warrants.</p>
      </details>

      <details class="faq-item">
        <summary>What areas do you cover?</summary>
        <p>My primary service area includes Guildford, Woking, Godalming, Farnham, Camberley and Cobham. I also serve the wider Surrey and Hampshire corridor. Remote delivery means clients anywhere in the UK or internationally receive the same standard of work.</p>
      </details>

      <details class="faq-item">
        <summary>How quickly can we start?</summary>
        <p>Most engagements begin within one week of agreement. The initial technical audit is typically delivered within the first five to seven working days, with strategic recommendations and implementation following immediately after.</p>
      </details>

      <details class="faq-item">
        <summary>Do you offer free consultations?</summary>
        <p>Yes. An initial discovery call is always free and carries no obligation. For a more detailed assessment, request a <a href="/free-seo-audit-guildford/">free SEO audit</a>. It provides a technical and strategic overview of your site before any commitment.</p>
      </details>
      </div>



      <div class="mt-8 pt-6 border-t border-border text-sm text-text-muted">
        <p>Explore more: <a href="/">Home</a> · <a href="/services/">Services</a> · <a href="/free-seo-audit-guildford/">Free SEO Audit</a> · <a href="/areas/">Areas We Cover</a></p>
      </div>
    </div>
  </section>
</Base>

<script>if(new URLSearchParams(window.location.search).get('sent')==='1'){const f=document.getElementById('enquire-form'),d=document.getElementById('enquire-done');if(f)f.hidden=true;if(d)d.hidden=false;}</script>
